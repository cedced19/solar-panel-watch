<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name=viewport content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="/assets/styles.css">
  <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
  <title>Solar Panel Watch<% if(error){ %> | <%= __('Shelly unavailable')%><% } %></title>
  <link rel=manifest href=/assets/manifest.json>
  <% if(error){ %>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body.unavailable-page {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      overflow: hidden;
      padding: 24px;
      color: #f8fafc;
      font-family: Arial, Helvetica, sans-serif;
      background: radial-gradient(circle at 20% 15%, #1e3a5f 0, transparent 35%), radial-gradient(circle at 80% 85%, #7c2d12 0, transparent 34%), #081321;
    }
    body.unavailable-page::before,
    body.unavailable-page::after {
      position: fixed;
      content: '';
      width: 340px;
      height: 340px;
      border-radius: 50%;
      opacity: .18;
      filter: blur(10px);
      pointer-events: none;
    }
    body.unavailable-page::before { top: -150px; right: -100px; background: #38bdf8; }
    body.unavailable-page::after { bottom: -180px; left: -90px; background: #fb923c; }
    .failure-card {
      position: relative;
      z-index: 1;
      width: min(100%, 610px);
      padding: clamp(28px, 6vw, 52px);
      border: 1px solid rgba(255, 255, 255, .14);
      border-radius: 28px;
      background: rgba(15, 23, 42, .76);
      box-shadow: 0 24px 70px rgba(0, 0, 0, .38);
      backdrop-filter: blur(18px);
    }
    .brand { margin: 0 0 42px; color: #cbd5e1; font-size: .82rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
    .failure-icon {
      display: grid;
      width: 68px;
      height: 68px;
      place-items: center;
      margin-bottom: 24px;
      color: #fed7aa;
      border: 1px solid rgba(251, 146, 60, .45);
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(249, 115, 22, .38), rgba(239, 68, 68, .18));
    }
    .failure-icon svg { width: 34px; height: 34px; }
    .status-badge { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 16px; color: #fed7aa; font-size: .86rem; font-weight: 700; }
    .status-dot { width: 9px; height: 9px; border-radius: 50%; background: #fb923c; box-shadow: 0 0 0 5px rgba(251, 146, 60, .13); }
    .failure-card h1 { margin: 0; font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -.04em; }
    .failure-description { max-width: 500px; margin: 16px 0 28px; color: #cbd5e1; font-size: 1.05rem; line-height: 1.65; }
    .failure-checks { display: grid; gap: 12px; margin: 0 0 30px; padding: 20px; list-style: none; border-radius: 16px; background: rgba(148, 163, 184, .10); }
    .failure-checks li { display: flex; gap: 11px; color: #e2e8f0; font-size: .95rem; line-height: 1.4; }
    .failure-checks li::before { content: '•'; color: #fb923c; font-size: 1.3rem; line-height: .85; }
    .retry-button { display: inline-flex; align-items: center; gap: 9px; padding: 13px 19px; color: #172033; font-weight: 700; text-decoration: none; border-radius: 12px; background: #f8fafc; transition: transform .16s ease, box-shadow .16s ease; }
    .retry-button:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(248, 250, 252, .2); }
    .safety-note { margin: 25px 0 0; color: #94a3b8; font-size: .86rem; line-height: 1.45; }
  </style>
  <% } else { %>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: Arial, Helvetica, sans-serif;
      padding: 10px;
    }
    .column {
      float: left;
      width: 50%;
      padding: 0 10px;
      margin-bottom: 15px;
    }
    .row {margin: 0 -5px;}
    .row:after {
      content: "";
      display: table;
      clear: both;
    }
    @media screen and (max-width: 600px) {
      .column {
        width: 100%;
        display: block;
        margin-bottom: 20px;
      }
    }
    .card {
      box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
      padding: 16px;
      text-align: center;
      background-color: #f1f1f1;
    }
    .card ul {
      list-style-type: none;
    }
    .recovery-warning {
      max-width: 900px;
      margin: 12px auto 28px;
      padding: 12px 16px;
      color: #7c2d12;
      border-left: 4px solid #f59e0b;
      border-radius: 6px;
      background: #fffbeb;
    }
  </style>
  <% } %>
</head>
<body<% if(error){ %> class="unavailable-page"<% } %>>
  <% if(error){ %>
    <main class="failure-card" role="alert">
      <p class="brand">Solar Panel Watch</p>
      <div class="failure-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      </div>
      <div class="status-badge"><span class="status-dot"></span><%= __('Shelly connection status')%></div>
      <h1><%= __('Shelly unavailable')%></h1>
      <p class="failure-description"><%= __('Shelly configuration error')%></p>
      <% if(recovery && recovery.enabled && recovery.notFound){ %>
        <p class="failure-description"><%= __('Shelly MAC not found')%> <code><%= recovery.macAddress %></code></p>
      <% } %>
      <ul class="failure-checks">
        <li><%= __('Check Shelly configuration')%></li>
        <li><%= __('Check network connection')%></li>
      </ul>
      <a class="retry-button" href="/"><span aria-hidden="true">↻</span><%= __('Retry')%></a>
      <p class="safety-note"><%= __('Safety mode')%></p>
    </main>
  <% } else{ %>
  <h2>Solar Panel Watch</h2>
  <div class="row">
    <div class="column">
      <div class="card" id="house-consumption-card" style="background-color:#<% if(power1<0){ %>badc58<% } else { %>fab1a0<% } %>;">
        <h3><span id="house-consumption"><%= Math.ceil(power1*100)/100 %></span> W</h3>
        <p><%= __('House consumption')%></p>
      </div>
    </div>
  
    <div class="column">
      <div class="card">
        <h3><span id="solar-panel-production"><%= Math.ceil(power2*100)/100 %></span> W</h3>
        <p><%= __('Solar panel production')%></p>
      </div>
    </div>
    
    <div class="column">
      <div class="card">
        <h3><span id="total-production"><%= Math.ceil((power1 + power2)*100)/100 %></span> W</h3>
        <p><%= __('Total Power')%></p>
      </div>
    </div>

    <div class="column">
      <div class="card">
        <h3><span id="activated-devices-power"><%= Math.ceil(power_activated_device*100)/100 %></span> W</h3>
        <p><%= __('Activated devices Power')%></p>
      </div>
    </div>

    <div class="column">
      <div class="card" id="available-power-card" style="background-color:#<% if((power_activated_device  + ((power1<0) ? -power1 : 0))>0){ %>badc58<% } else { %>f1f1f1<% } %>;">
        <h3><span id="available-power"><%= Math.ceil((power_activated_device  + ((power1<0) ? -power1 : 0))*100)/100 %></span> W</h3>
        <p><%= __('Available Power')%></p>
      </div>
    </div>
    <% if(list_devices.length){ %>
      <div class="column">
        <div class="card">
          <p><%= __('Connected Devices')%></p>
          <ul>
            <% for(var i=0; i < list_devices.length; i++) { %>
              <li><a href="/device/<%= list_devices[i] %>"><%= pretty_name(list_devices[i]) %></a> (<span id="<%= list_devices[i] %>-power"><%= Math.floor(device_states[list_devices[i]].last_power) %></span> W)</li>
            <% } %>
          </ul>
        </div>
      </div>
    <% } %>
    <div class="column">
      <div class="card">
        <ul>
          <li><a href="/graph/power/2h/"><%= __('Raw data 2h')%></a></li>
          <li><a href="/graph/power/1d/"><%= __('Raw data 1d')%></a></li>
          <li><a  href="/graph/power/1d/group-by/5m"><%= __('Mean data 1d')%></a></li>
          <li><a  href="/graph/power/1w/group-by/15m"><%= __('Mean data 1w')%></a></li>
          <li><a  href="/energy/3d"><%= __('Energy')%></a></li>
          <li><a  href="/energy-hist/"><%= __('Energy request history')%></a></li>
          <li><a  href="/energy-graph/"><%= __('Energy graph')%></a></li>
          <li><a  href="/activation-hist/"><%= __('Activation history')%></a></li>
          <li><a  href="/graph/power/1d/activation-hist-plot/"><%= __('Activation history plot')%></a></li>
          <li><a  href="/device/list/graph/24h"><%= __('Graph power from devices')%> (24h)</a></li>
          <li><a  href="/device/list/graph/2h"><%= __('Graph power from devices')%> (2h)</a></li>
          <li><a  href="/force/"><%= __('Force devices')%></a></li>
        </ul>
      </div>
    </div>
  </div>
  <% if(recovered_shelly_ip){ %>
    <p class="recovery-warning"><strong><%= __('Recovered Shelly warning')%></strong> <code><%= recovered_shelly_ip %></code></p>
  <% } %>
  <% } %>
  <% if(!error){ %>
  <script>
    const houseConsumptionEl = document.getElementById('house-consumption');
    const houseConsumptionCard = document.getElementById('house-consumption-card');
    const solarPanelProductionEl = document.getElementById('solar-panel-production');
    const totalPowerEl = document.getElementById('total-production');
    const activatedDevicesPowerEl = document.getElementById('activated-devices-power');
    const availablePowerCard = document.getElementById('available-power-card');
    const availablePowerEl = document.getElementById('available-power');

    function request_data(cb) {
      let url = '/api/data';
      fetch(url)
      .then(function(res) { return res.json() })
      .then(function(out) { cb(null, out) })
      .catch(function(err) { console.error(err); cb(err)});
    }

    function update_labels() {
      request_data(function(err, data) {
        houseConsumptionEl.textContent = Math.ceil(data.power1*100)/100;
        solarPanelProductionEl.textContent = Math.ceil(data.power2*100)/100;
        totalPowerEl.textContent = Math.ceil((data.power1 + data.power2)*100)/100;
        activatedDevicesPowerEl.textContent = Math.ceil(data.power_activated_device*100)/100;
        let availablePower = data.power_activated_device;
        if (data.power1<0) {
          availablePower-=data.power1;
        }
        availablePowerEl.textContent = Math.ceil(availablePower*100)/100;
        if (data.power1 < 0) {
            houseConsumptionCard.style.background = "#badc58";
        } else {
            houseConsumptionCard.style.background = "#fab1a0";
        }
        if (availablePower > 0) {
          availablePowerCard.style.background = "#badc58";
        } else {
          availablePowerCard.style.background = "#f1f1f1";
        }
        Object.keys(data.device_states).forEach(function (el) {
          let device = data.device_states[el];
          let span = document.getElementById(el + '-power');
          if (span != null) {
            span.innerHTML = device.last_power;
          }
        });
      });
    }
    let interval = setInterval(update_labels, 10000);
    document.addEventListener('visibilitychange', function() {
        if(document.hidden) {
          clearInterval(interval);
        } else {
          update_labels();
          interval = setInterval(update_labels, 10000);
        }
    });
    
  </script>
  <% } %>
</body>
</html>
