<%
  const source = typeof power_source !== 'undefined' && power_source === 'zendure' ? 'zendure' : 'shelly';
  const unavailableKey = source === 'zendure' ? 'Zendure unavailable' : 'Shelly unavailable';
  const batteryData = typeof battery !== 'undefined' && battery && Number.isFinite(battery.socPercent) && battery.socPercent >= 0 && battery.socPercent <= 100 ? battery : null;
  const batteryInterval = typeof zendure_battery_req_threshold !== 'undefined' && Number.isFinite(zendure_battery_req_threshold) && zendure_battery_req_threshold > 0 ? zendure_battery_req_threshold : 20000;
  const batteryStateKeys = {charging: 'Battery charging', standby: 'Battery standby', discharging: 'Battery discharging'};
  const deviceChargingKeys = {
    'soc-above-threshold': 'Device charging allowed above SOC',
    'soc-at-or-below-threshold': 'Device charging blocked below SOC',
    'battery-unavailable': 'Device charging blocked battery unavailable',
    'power-unavailable': 'Device charging blocked power unavailable'
  };
  const deviceCharging = typeof device_charging !== 'undefined' && device_charging && typeof device_charging.enabled === 'boolean' && Object.prototype.hasOwnProperty.call(deviceChargingKeys, device_charging.reason) ? device_charging : {enabled: false, reason: 'battery-unavailable'};
  const hasSolarPower = typeof power2 !== 'undefined' && Number.isFinite(power2);
%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name=viewport content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="/assets/styles.css">
  <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
  <title>Solar Panel Watch<% if(error){ %> | <%= __(unavailableKey)%><% } %></title>
  <link rel=manifest href=/assets/manifest.json>
  <% if(error){ %>
  <link rel="stylesheet" href="/assets/error_page.css">
  <% } else { %>
  <link rel="stylesheet" href="/assets/main_page.css">
  <% } %>
</head>
<body<% if(error){ %> class="unavailable-page"<% } else { %> class="dashboard-page"<% } %>>
  <% if(error){ %>
    <main class="failure-card" role="alert">
      <p class="brand">Solar Panel Watch</p>
      <div class="failure-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      </div>
      <div class="status-badge"><span class="status-dot"></span><%= __(source === 'zendure' ? 'Zendure connection status' : 'Shelly connection status')%></div>
      <h1><%= __(unavailableKey)%></h1>
      <p class="failure-description"><%= __(source === 'zendure' ? 'Zendure configuration error' : 'Shelly configuration error')%></p>
      <% if(recovery && recovery.enabled && recovery.notFound){ %>
        <p class="failure-description"><%= __(source === 'zendure' ? 'Zendure MAC not found' : 'Shelly MAC not found')%> <code><%= recovery.macAddress %></code></p>
      <% } %>
      <ul class="failure-checks">
        <li><%= __(source === 'zendure' ? 'Check Zendure configuration' : 'Check Shelly configuration')%></li>
        <li><%= __(source === 'zendure' ? 'Check Zendure network connection' : 'Check network connection')%></li>
      </ul>
      <a class="retry-button" href="/"><span aria-hidden="true">↻</span><%= __('Retry')%></a>
      <p class="safety-note"><%= __('Safety mode')%></p>
    </main>
  <% } else{ %>
  <main class="dashboard-shell" id="dashboard" data-unavailable="<%= __('Unavailable')%>">
    <header class="dashboard-header">
      <div>
        <h1>Solar Panel Watch</h1>
      </div>
      <span class="dashboard-status" id="dashboard-status" aria-live="polite" data-live-label="<%= __('Live')%>"><%= __('Live')%></span>
    </header>
    <div class="dashboard-grid">
      <section class="card available-power-card<% if((power_activated_device  + ((power1<0) ? -power1 : 0))<=0){ %> is-empty<% } %>" id="available-power-card">
        <div class="power-value"><span id="available-power"><%= Math.ceil((power_activated_device  + ((power1<0) ? -power1 : 0))*100)/100 %></span><span class="power-unit">W</span></div>
        <p class="card-label"><%= __('Available Power')%></p>
      </section>

      <section class="card stat-card house-consumption-card<% if(power1<0){ %> is-producing<% } %>" id="house-consumption-card">
        <div class="power-value"><span id="house-consumption"><%= Math.ceil(power1*100)/100 %></span><span class="power-unit">W</span></div>
        <p class="card-label"><%= __('House consumption')%></p>
      </section>

      <section class="card stat-card<% if(!hasSolarPower){ %> is-unavailable<% } %>" id="solar-production-card">
        <div class="power-value"><span id="solar-panel-production"><%= hasSolarPower ? Math.ceil(power2*100)/100 : __('Unavailable') %></span><span class="power-unit">W</span></div>
        <p class="card-label"><%= __('Solar panel production')%></p>
      </section>

      <section class="card stat-card<% if(!hasSolarPower){ %> is-unavailable<% } %>" id="total-power-card">
        <div class="power-value"><span id="total-production"><%= hasSolarPower ? Math.ceil((power1 + power2)*100)/100 : __('Unavailable') %></span><span class="power-unit">W</span></div>
        <p class="card-label"><%= __('Total Power')%></p>
      </section>

      <section class="card stat-card" id="activated-devices-card">
        <div class="power-value"><span id="activated-devices-power"><%= Math.ceil(power_activated_device*100)/100 %></span><span class="power-unit">W</span></div>
        <p class="card-label"><%= __('Activated devices Power')%></p>
      </section>

      <section class="card battery-card<% if(!batteryData){ %> is-unavailable<% } %>" id="battery-card" data-poll-interval="<%= batteryInterval %>" data-charging="<%= __('Battery charging')%>" data-standby="<%= __('Battery standby')%>" data-discharging="<%= __('Battery discharging')%>">
        <div class="battery-heading">
          <h2 class="card-heading" id="battery-label"><%= __('Zendure battery level')%></h2>
          <div class="power-value" aria-live="polite"><span id="battery-level"><%= batteryData ? Math.round(batteryData.socPercent * 10)/10 : __('Unavailable') %></span><span class="power-unit">%</span></div>
        </div>
        <progress id="battery-progress" max="100" aria-labelledby="battery-label"<% if(batteryData){ %> value="<%= batteryData.socPercent %>"<% } else { %> hidden<% } %>></progress>
        <p class="device-charging-status<% if(deviceCharging.enabled){ %> is-enabled<% } %>" id="device-charging-status" aria-live="polite" data-soc-above-threshold="<%= __('Device charging allowed above SOC') %>" data-soc-at-or-below-threshold="<%= __('Device charging blocked below SOC') %>" data-battery-unavailable="<%= __('Device charging blocked battery unavailable') %>" data-power-unavailable="<%= __('Device charging blocked power unavailable') %>"><%= __(deviceChargingKeys[deviceCharging.reason]).replace('{soc}', deviceCharging.minSocPercent) %></p>
        <p class="battery-state" id="battery-state" aria-live="polite"><%= batteryData && Object.prototype.hasOwnProperty.call(batteryStateKeys, batteryData.state) ? __(batteryStateKeys[batteryData.state]) : '' %></p>
        <p class="battery-source" id="battery-source"<% if(!batteryData || batteryData.socSource !== 'electricLevel'){ %> hidden<% } %>><%= __('Battery device average')%></p>
      </section>

      <nav class="featured-actions" aria-label="Featured actions">
        <a class="action-button" href="/device/list/graph/2h">
          <span class="action-icon" aria-hidden="true"><img src="/assets/icons/power-graph.svg" alt=""></span>
          <span><%= __('Graph power from devices 2h')%></span>
        </a>
        <a class="action-button" href="/force/">
          <span class="action-icon" aria-hidden="true"><img src="/assets/icons/force-devices.svg" alt=""></span>
          <span><%= __('Force devices')%></span>
        </a>
        <a class="action-button" href="/energy/3d">
          <span class="action-icon" aria-hidden="true"><img src="/assets/icons/energy-summary.svg" alt=""></span>
          <span><%= __('Energy summary')%></span>
        </a>
      </nav>

    <% if(list_devices.length){ %>
      <section class="card device-card">
          <h2 class="card-heading"><%= __('Connected Devices')%></h2>
          <ul class="device-list">
            <% for(var i=0; i < list_devices.length; i++) { %>
              <li><a href="/device/<%= list_devices[i] %>"><%= pretty_name(list_devices[i]) %></a><span class="device-power"><span id="<%= list_devices[i] %>-power"><%= Math.floor(device_states[list_devices[i]].last_power) %></span> W</span></li>
            <% } %>
          </ul>
      </section>
    <% } %>
      <nav class="card links-card" aria-label="Dashboard links">
        <h2 class="card-heading"><%= __('Other')%></h2>
        <ul class="dashboard-links">
          <li><a href="/graph/power/2h/"><%= __('Raw data 2h')%></a></li>
          <li><a href="/graph/power/1d/"><%= __('Raw data 1d')%></a></li>
          <li><a  href="/graph/power/1d/group-by/5m"><%= __('Mean data 1d')%></a></li>
          <li><a  href="/graph/power/1w/group-by/15m"><%= __('Mean data 1w')%></a></li>
          <li><a  href="/energy-hist/"><%= __('Energy request history')%></a></li>
          <li><a  href="/energy-graph/"><%= __('Energy graph')%></a></li>
          <li><a  href="/energy-calendar/"><%= __('Energy calendar')%></a></li>
          <li><a  href="/activation-hist/"><%= __('Activation history')%></a></li>
          <li><a  href="/graph/power/1d/activation-hist-plot/"><%= __('Activation history plot')%></a></li>
          <li><a  href="/device/list/graph/24h"><%= __('Graph power from devices')%> (24h)</a></li>
        </ul>
      </nav>
    </div>
  <% if(recovered_shelly_ip){ %>
    <p class="recovery-warning"><strong><%= __('Recovered Shelly warning')%></strong> <code><%= recovered_shelly_ip %></code></p>
  <% } %>
  <% if(typeof recovered_zendure_ip !== 'undefined' && recovered_zendure_ip){ %>
    <p class="recovery-warning"><strong><%= __('Recovered Zendure warning')%></strong> <code><%= recovered_zendure_ip %></code></p>
  <% } %>
  </main>
  <% } %>
  <% if(!error){ %>
  <script>
    const dashboard = document.getElementById('dashboard');
    const unavailableLabel = dashboard.dataset.unavailable;
    const dashboardStatus = document.getElementById('dashboard-status');
    const houseConsumptionEl = document.getElementById('house-consumption');
    const houseConsumptionCard = document.getElementById('house-consumption-card');
    const solarPanelProductionEl = document.getElementById('solar-panel-production');
    const solarPanelProductionCard = document.getElementById('solar-production-card');
    const totalPowerEl = document.getElementById('total-production');
    const totalPowerCard = document.getElementById('total-power-card');
    const activatedDevicesPowerEl = document.getElementById('activated-devices-power');
    const activatedDevicesCard = document.getElementById('activated-devices-card');
    const availablePowerCard = document.getElementById('available-power-card');
    const availablePowerEl = document.getElementById('available-power');
    const batteryCard = document.getElementById('battery-card');
    const batteryLevelEl = document.getElementById('battery-level');
    const batteryProgress = document.getElementById('battery-progress');
    const batteryStateEl = document.getElementById('battery-state');
    const batterySourceEl = document.getElementById('battery-source');
    const deviceChargingStatusEl = document.getElementById('device-charging-status');
    const deviceChargingReasons = {
      'soc-above-threshold': deviceChargingStatusEl.dataset.socAboveThreshold,
      'soc-at-or-below-threshold': deviceChargingStatusEl.dataset.socAtOrBelowThreshold,
      'battery-unavailable': deviceChargingStatusEl.dataset.batteryUnavailable,
      'power-unavailable': deviceChargingStatusEl.dataset.powerUnavailable
    };
    const batteryStates = {
      charging: batteryCard.dataset.charging,
      standby: batteryCard.dataset.standby,
      discharging: batteryCard.dataset.discharging
    };
    const configuredBatteryInterval = Number(batteryCard.dataset.pollInterval);
    const batteryPollInterval = Number.isFinite(configuredBatteryInterval) && configuredBatteryInterval > 0 ? configuredBatteryInterval : 20000;
    let powerRequestPending = false;
    let batteryRequestPending = false;
    let powerInterval;
    let batteryInterval;

    async function requestData(url) {
      const response = await fetch(url, {cache: 'no-store'});
      const data = await response.json().catch(function (error) {
        if (response.ok) throw error;
        return null;
      });
      if (!response.ok) {
        const error = new Error('Data request failed: ' + response.status);
        error.data = data;
        throw error;
      }
      return data;
    }

    function setPower(element, card, value) {
      const available = Number.isFinite(value);
      element.textContent = available ? Math.ceil(value * 100) / 100 : unavailableLabel;
      card.classList.toggle('is-unavailable', !available);
    }

    function renderDeviceCharging(data, fallbackReason) {
      const available = data && typeof data.enabled === 'boolean' && Object.prototype.hasOwnProperty.call(deviceChargingReasons, data.reason);
      const status = available ? data : {enabled: false, reason: fallbackReason};
      deviceChargingStatusEl.textContent = deviceChargingReasons[status.reason].replace('{soc}', status.minSocPercent);
      deviceChargingStatusEl.classList.toggle('is-enabled', status.enabled);
    }

    function renderPower(data, deviceCharging) {
      const housePower = data && Number.isFinite(data.power1) ? data.power1 : null;
      const solarPower = data && Number.isFinite(data.power2) ? data.power2 : null;
      const devicePower = data && Number.isFinite(data.power_activated_device) ? data.power_activated_device : null;
      const availablePower = housePower !== null && devicePower !== null ? devicePower + Math.max(-housePower, 0) : null;
      const totalPower = housePower !== null && solarPower !== null ? housePower + solarPower : null;

      setPower(houseConsumptionEl, houseConsumptionCard, housePower);
      setPower(solarPanelProductionEl, solarPanelProductionCard, solarPower);
      setPower(totalPowerEl, totalPowerCard, totalPower);
      setPower(activatedDevicesPowerEl, activatedDevicesCard, devicePower);
      setPower(availablePowerEl, availablePowerCard, availablePower);
      houseConsumptionCard.classList.toggle('is-producing', housePower !== null && housePower < 0);
      availablePowerCard.classList.toggle('is-empty', availablePower !== null && availablePower <= 0);
      dashboardStatus.textContent = housePower !== null ? dashboardStatus.dataset.liveLabel : unavailableLabel;
      dashboardStatus.classList.toggle('is-unavailable', housePower === null);

      document.querySelectorAll('.device-power span').forEach(function (span) {
        const name = span.id.slice(0, -'-power'.length);
        const device = data && data.device_states && data.device_states[name];
        span.textContent = device && Number.isFinite(device.last_power) ? Math.floor(device.last_power) : unavailableLabel;
      });
      renderDeviceCharging(deviceCharging || (data && data.device_charging), data ? 'battery-unavailable' : 'power-unavailable');
    }

    async function update_labels() {
      if (powerRequestPending) return;
      powerRequestPending = true;
      try {
        renderPower(await requestData('/api/data'));
      } catch (error) {
        renderPower(null, error.data && error.data.device_charging);
      } finally {
        powerRequestPending = false;
      }
    }

    function renderBattery(data, deviceCharging) {
      const available = data && Number.isFinite(data.socPercent) && data.socPercent >= 0 && data.socPercent <= 100;
      batteryCard.classList.toggle('is-unavailable', !available);
      batteryLevelEl.textContent = available ? Math.round(data.socPercent * 10) / 10 : unavailableLabel;
      batteryProgress.hidden = !available;
      if (available) {
        batteryProgress.value = data.socPercent;
      } else {
        batteryProgress.removeAttribute('value');
      }
      batteryStateEl.textContent = available && Object.prototype.hasOwnProperty.call(batteryStates, data.state) ? batteryStates[data.state] : '';
      batterySourceEl.hidden = !available || data.socSource !== 'electricLevel';
      renderDeviceCharging(deviceCharging || (data && data.device_charging), 'battery-unavailable');
    }

    async function updateBattery() {
      if (batteryRequestPending) return;
      batteryRequestPending = true;
      try {
        renderBattery(await requestData('/api/battery'));
      } catch (error) {
        renderBattery(null, error.data && error.data.device_charging);
      } finally {
        batteryRequestPending = false;
      }
    }

    function stopTimers() {
      clearInterval(powerInterval);
      clearInterval(batteryInterval);
    }

    function startTimers() {
      stopTimers();
      if (!document.hidden) {
        powerInterval = setInterval(update_labels, 10000);
        batteryInterval = setInterval(updateBattery, batteryPollInterval);
      }
    }

    startTimers();
    document.addEventListener('visibilitychange', function() {
      startTimers();
      if (!document.hidden) {
        update_labels();
        updateBattery();
      }
    });
    window.addEventListener('pagehide', stopTimers);
    window.addEventListener('pageshow', function(event) {
      if (event.persisted) {
        startTimers();
        if (!document.hidden) {
          update_labels();
          updateBattery();
        }
      }
    });
  </script>
  <% } %>
</body>
</html>
