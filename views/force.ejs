<%
  // Texts used by /assets/force.js, keyed by the name the script uses.
  const messages = {
    enabled: __('enabled forcing'),
    disabled: __('disabled forcing'),
    success: __('Successfull request'),
    'invalid-percent': __('Force invalid percent')
  };
%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name=viewport content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="<%= asset('/assets/styles.css') %>">
  <link rel="stylesheet" href="<%= asset('/assets/main_page.css') %>">
  <link rel="stylesheet" href="<%= asset('/assets/pages.css') %>">
  <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
  <link rel=manifest href=/assets/manifest.json>
  <title>Solar Panel Watch</title>
</head>
<body class="dashboard-page subpage login-page">
  <main class="dashboard-shell">
    <header class="dashboard-header">
      <div class="header-title">
        <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
        <nav class="header-nav" aria-label="Navigation">
          <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
          <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          <button class="nav-btn" id="logout-btn" type="button" hidden title="<%= __('Config log out')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span class="nav-label"><%= __('Config log out')%></span>
          </button>
        </nav>
      </div>
    </header>

    <%- include('partials/login', {title: __('Force sign in')}) %>

  <div class="dashboard-grid" id="force-view" data-messages="<%= JSON.stringify(messages) %>" hidden>
    <% if(list_devices.length){ %>
      <section class="card force-card settings-card">
          <h2 class="card-heading"><%= __('Settings')%></h2>
          <p>
            <label for="percent"><%= __('Percent')%></label>
            <input type="number" id="percent" name="percent" min="0" max="1" step="0.01">
          </p>
      </section>
      <% for(var i=0; i < list_devices.length; i++) { %>
      <section class="card force-card" data-device="<%= list_devices[i] %>">
          <h2 class="card-heading"><%= pretty_name(list_devices[i]) %></h2>
          <p class="force-meta">
            <span class="force-mode">…</span>,
            <span class="force-percent">…</span> %,
            <span class="force-power">…</span> W
          </p>
          <ul>
              <li><a data-action="force" href="#"><%= __('Force device')%> / <%= __('Change percent')%></a></li>
              <li><a data-action="release" href="#"><%= __('Disable force device')%></a></li>
              <li><a data-action="stop" href="#"><%= __('Stop')%></a></li>
          </ul>
          <p class="res" role="status"></p>
      </section>
      <% } %>
    <% } else { %>
      <p><%= __('No devices')%></p>
    <% } %>
  </div>
  </main>
  <script src="<%= asset('/assets/nav.js') %>"></script>
  <script src="<%= asset('/assets/login.js') %>"></script>
  <script src="<%= asset('/assets/force.js') %>"></script>
</body>
</html>
