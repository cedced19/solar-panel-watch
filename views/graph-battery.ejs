<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="/assets/main_page.css">
    <link rel="stylesheet" href="/assets/pages.css">
    <link href="/favicon.ico" rel="shortcut icon" type="image/x-icon">
    <title>Solar Panel Watch | <%= __('Battery SOC history') %></title>
  </head>
  <body class="dashboard-page subpage graph-page battery-graph-page">
    <main class="dashboard-shell" id="battery-history-page" aria-busy="true" data-period="<%= period %>" data-timezone="<%= timezone %>" data-title="<%= __('Battery SOC over time') %>" data-soc-label="<%= __('Battery SOC (%)') %>" data-time-label="<%= __('Time') %>" data-empty-label="<%= __('No battery history') %>" data-error-label="<%= __('Battery history unavailable') %>">
      <header class="dashboard-header">
        <div class="header-title">
          <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
          <nav class="header-nav" aria-label="Navigation">
            <a class="nav-btn" href="/" title="<%= __('Home') %>">
              <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span class="nav-label"><%= __('Home') %></span>
            </a>
            <button class="nav-btn" id="nav-back" type="button" title="<%= __('Back') %>">
              <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              <span class="nav-label"><%= __('Back') %></span>
            </button>
          </nav>
        </div>
      </header>
      <div class="graph-shell">
        <div class="battery-graph-toolbar">
          <h2 class="battery-graph-title"><%= __('Battery SOC history') %> <span>(<%= period %>)</span></h2>
          <nav class="battery-period-nav" aria-label="<%= __('Battery SOC history') %>">
            <% for (const option of [{period: '2h', label: 'Last 2 hours'}, {period: '24h', label: 'Last 24 hours'}, {period: '7d', label: 'Last 7 days'}]) { %>
              <a class="nav-btn" href="/graph/battery/<%= option.period %>"<% if (period === option.period) { %> aria-current="page"<% } %>><%= __(option.label) %></a>
            <% } %>
            <a class="nav-btn" href="/api/data/battery/<%= period %>?format=csv" download="battery-soc-<%= period %>.csv"><%= __('Download CSV') %></a>
          </nav>
        </div>
        <div id="loader" class="loader" aria-hidden="true"></div>
        <section class="card graph-card" id="battery-graph-card" hidden>
          <div id="graphs-container"></div>
        </section>
        <div class="battery-graph-status" id="battery-graph-status" role="status" aria-live="polite" hidden>
          <p id="battery-graph-message"></p>
          <button class="nav-btn" id="battery-graph-retry" type="button"><%= __('Retry') %></button>
        </div>
      </div>
    </main>
    <script src="/assets/plotly.js"></script>
    <script src="/assets/battery-graph.js"></script>
    <script src="/assets/nav.js"></script>
  </body>
</html>
