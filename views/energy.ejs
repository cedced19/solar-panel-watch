<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name=viewport content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="<%= asset('/assets/styles.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/main_page.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/pages.css') %>">
    <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
    <title>Solar panel watch | <%= __('Current day energy')%></title>
  </head>
  <body class="dashboard-page subpage">
    <main class="dashboard-shell">
      <header class="dashboard-header">
        <div class="header-title">
          <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
          <nav class="header-nav" aria-label="Navigation">
            <%- include('partials/nomenclature-link') %>
            <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
            <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          </nav>
        </div>
      </header>
      <div id="loader" class="loader"></div>
      <div id="day-swipe" class="day-swipe">
        <section class="card">
          <h2 class="card-heading"><%= __('Current day energy')%></h2>
          <%- include('partials/energy-day-nav') %>
          <div id="table"></div>
        </section>
        <%- include('partials/energy-day-visuals', {intraday: true}) %>
      </div>
    </main>
    <script src="<%= asset('/assets/plotly.js') %>"></script>
    <script src="<%= asset('/assets/energy-consumption.js') %>"></script>
    <script src="<%= asset('/assets/energy-day-visuals.js') %>"></script>
    <script src="<%= asset('/assets/day-swipe.js') %>"></script>
    <%- include('partials/energy-day-table') %>
    <script>
        const currentDay = '<%= day%>';
        const showDay = (row) => {
            renderEnergyDay(document.getElementById('table'), row, showDay, {heading: false});
            document.getElementById('loader').style.display = 'none';
            window.energyDayVisuals.render(row);
        };
        const loadData = () => {
            fetch('/api/data/energy/day/' + currentDay)
                .then(response => response.json())
                .then(showDay)
                .catch((error) => {
                    console.error('Error:', error);
                });
        }

        // Today is the last day: the earlier days are shown by the calendar.
        const showPreviousDay = () => {
            window.location.href = '/energy-calendar/#day=' + window.daySwipe.shiftDay(currentDay, -1);
        };
        document.getElementById('day-nav-label').textContent = currentDay;
        document.getElementById('day-next').disabled = true;
        document.getElementById('day-prev').addEventListener('click', showPreviousDay);
        window.daySwipe.attach(document.getElementById('day-swipe'), {
            canSwipe: direction => direction === 'prev',
            onSwipe: showPreviousDay
        });
        window.addEventListener('load', loadData);
    </script>
      <script src="<%= asset('/assets/nav.js') %>"></script>
</body>
</html>
