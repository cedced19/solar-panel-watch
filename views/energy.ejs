<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name=viewport content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="/assets/main_page.css">
    <link rel="stylesheet" href="/assets/pages.css">
    <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
    <title>Solar panel watch | <%= __('Current day energy')%></title>
  </head>
  <body class="dashboard-page subpage">
    <main class="dashboard-shell">
      <header class="dashboard-header">
        <div class="header-title">
          <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
          <nav class="header-nav" aria-label="Navigation">
            <%- include('partials/nomenclature-link') %>
            <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
            <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          </nav>
        </div>
      </header>
      <div id="loader" class="loader"></div>
      <section class="card">
        <h2 class="card-heading"><%= __('Current day energy')%></h2>
        <div id="table"></div>
      </section>
      <div id="energy-day-visuals" class="energy-visuals" hidden
           data-day="<%= day %>" data-day-start="<%= day_start %>" data-timezone="<%= timezone %>"
           data-solar="<%= __('Nomenclature solar short') %>" data-grid="<%= __('Nomenclature grid short') %>"
           data-battery="<%= __('Nomenclature battery short') %>" data-house="<%= __('Nomenclature household use') %>"
           data-solar-produced="<%= __('Solar production') %>" data-house-consumption="<%= __('Nomenclature household use') %>"
           data-grid-import="<%= __('Grid import') %>" data-grid-export="<%= __('Grid export') %>"
           data-battery-discharging="<%= __('Battery discharge') %>" data-battery-charging="<%= __('Battery charge') %>"
           data-grid-signed="<%= __('Grid signed') %>" data-battery-signed="<%= __('Battery signed') %>"
           data-self-sufficiency="<%= __('Self-sufficiency') %>" data-self-sufficiency-hint="<%= __('Self-sufficiency hint') %>"
           data-self-consumption="<%= __('Self-consumption') %>" data-self-consumption-hint="<%= __('Self-consumption hint') %>"
           data-of-house="<%= __('of household use') %>" data-unavailable="<%= __('Unavailable') %>"
           data-time="<%= __('Time') %>" data-profile-error="<%= __('Power history unavailable') %>"
           data-profile-empty="<%= __('No power readings') %>">
        <section class="card energy-glance" id="energy-glance-card">
          <h2 class="card-heading"><%= __('Day at a glance')%></h2>
          <div class="energy-rings" id="energy-rings"></div>
          <div class="energy-tiles" id="energy-tiles"></div>
        </section>
        <section class="card" id="energy-flow-card">
          <h2 class="card-heading"><%= __('Energy flow')%></h2>
          <p class="energy-visual-note"><%= __('Energy flow note')%></p>
          <div id="energy-flow" class="energy-plot"></div>
        </section>
        <div class="energy-visual-grid" id="energy-donuts">
          <section class="card" id="energy-house-sources-card">
            <h2 class="card-heading"><%= __('House supplied by')%></h2>
            <div id="energy-house-sources" class="energy-plot"></div>
          </section>
          <section class="card" id="energy-solar-uses-card">
            <h2 class="card-heading"><%= __('Solar energy used for')%></h2>
            <div id="energy-solar-uses" class="energy-plot"></div>
          </section>
        </div>
        <section class="card">
          <h2 class="card-heading"><%= __('Power since midnight')%></h2>
          <p class="energy-visual-note"><%= __('Power since midnight note')%></p>
          <p id="energy-profile-status" class="energy-visual-status" role="status" hidden></p>
          <div id="energy-profile" class="energy-plot"></div>
        </section>
        <section class="card" id="energy-hourly-card">
          <h2 class="card-heading"><%= __('Hourly energy')%></h2>
          <p class="energy-visual-note"><%= __('Hourly energy note')%></p>
          <div id="energy-hourly" class="energy-plot"></div>
        </section>
      </div>
    </main>
    <script src="/assets/plotly.js"></script>
    <script src="/assets/energy-consumption.js"></script>
    <script src="/assets/energy-day-visuals.js"></script>
    <%- include('partials/energy-day-table') %>
    <script>
        const showDay = (row) => {
            renderEnergyDay(document.getElementById('table'), row, showDay);
            document.getElementById('loader').style.display = 'none';
            window.energyDayVisuals.render(row);
        };
        const loadData = () => {
            fetch('/api/data/energy/day/<%= day%>')
                .then(response => response.json())
                .then(showDay)
                .catch((error) => {
                    console.error('Error:', error);
                });
        }
        window.addEventListener('load', loadData);
    </script>
      <script src="/assets/nav.js"></script>
</body>
</html>
