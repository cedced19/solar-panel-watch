<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name=viewport content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="<%= asset('/assets/styles.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/main_page.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/pages.css') %>">
    <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
    <style>
        .graph-section {
            width: 100%;
            margin: 24px 0;
            background: #ffffff;
            padding: 20px;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, .05);
            overflow-x: auto;
            overflow-y: visible;
        }
        .graph-section h3 {
            margin-bottom: 14px;
            font-size: 1.1rem;
            color: #111827;
        }
        .graph-controls {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            font-size: .9rem;
            color: #475569;
        }
        .graph-controls label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        .graph-controls input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }
        .graph-controls select {
            padding: 6px 10px;
            font-size: .85rem;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
            cursor: pointer;
        }
        .graph-container {
            width: 100%;
            height: 400px;
            overflow: hidden;
            position: relative;
        }
        .global-controls {
            margin: 16px 0;
            padding: 16px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, .05);
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }
        .global-controls label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #111827;
        }
        .global-controls input[type="date"] {
            width: auto;
            padding: 6px 12px;
        }
        .global-controls button {
            padding: 6px 16px;
        }
    </style>
    <title>Solar panel watch | <%= __('Energy graph')%></title>
  </head>
  <body class="dashboard-page subpage">
    <main class="dashboard-shell">
      <header class="dashboard-header">
        <div class="header-title">
          <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
          <nav class="header-nav" aria-label="Navigation">
            <%- include('partials/nomenclature-link') %>
            <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
            <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          </nav>
        </div>
      </header>
        <div id="loader" class="loader"></div>
        
        <!-- Global Controls -->
        <div class="global-controls" id="global-controls" style="display: none;">
            <label>
                <span><%= __("Aggregation")%>:</span>
                <select id="aggregation-select">
                    <option value="day"><%= __("Day")%></option>
                    <option value="week"><%= __("Week")%></option>
                    <option value="month"><%= __("Month")%></option>
                    <option value="year"><%= __("Year")%></option>
                </select>
            </label>
            <label>
                <span><%= __("From")%>:</span>
                <input type="date" id="range-start" />
            </label>
            <label>
                <span><%= __("To")%>:</span>
                <input type="date" id="range-end" />
            </label>
            <button type="button" id="range-reset"><%= __("Whole period")%></button>
        </div>
        <p id="fill-progress" class="calendar-hint" style="display: none;"></p>

        <!-- Day clicked in a day graph -->
        <div class="graph-section" id="day-section" style="display: none;">
            <div id="day-result"></div>
        </div>
        
        <!-- Consumption on Network Graph -->
        <div class="graph-section" id="consumption-section" style="display: none;">
            <h3><%= __("Consumption on network")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-consumption" />
                    <span><%= __("Color weekends")%></span>
                </label>
            </div>
            <div id="graph-consumption" class="graph-container"></div>
        </div>

        <!-- Solar Panel Production Graph -->
        <div class="graph-section" id="solar-section" style="display: none;">
            <h3><%= __("Solar panel production energy")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-solar" />
                    <span><%= __("Color weekends")%></span>
                </label>
                <label>
                    <input type="checkbox" id="show-sunshine-solar" />
                    <span><%= __("Show sunshine duration")%></span>
                </label>
            </div>
            <div id="graph-solar" class="graph-container"></div>
        </div>

        <div class="graph-section" id="battery-discharging-section" style="display: none;">
            <h3><%= __("Battery discharging energy")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-battery-discharging" />
                    <span><%= __("Color weekends")%></span>
                </label>
            </div>
            <div id="graph-battery-discharging" class="graph-container"></div>
        </div>

        <div class="graph-section" id="battery-charging-section" style="display: none;">
            <h3><%= __("Battery charging energy")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-battery-charging" />
                    <span><%= __("Color weekends")%></span>
                </label>
            </div>
            <div id="graph-battery-charging" class="graph-container"></div>
        </div>

        <!-- Energy Saved Graph -->
        <div class="graph-section" id="saved-section" style="display: none;">
            <h3><%= __("Energy Saved")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-saved" />
                    <span><%= __("Color weekends")%></span>
                </label>
            </div>
            <div id="graph-saved" class="graph-container"></div>
        </div>

        <!-- Energy Introduced Graph -->
        <div class="graph-section" id="introduced-section" style="display: none;">
            <h3><%= __("Energy Introduced")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-introduced" />
                    <span><%= __("Color weekends")%></span>
                </label>
            </div>
            <div id="graph-introduced" class="graph-container"></div>
        </div>

        <!-- Total Energy Used Graph -->
        <div class="graph-section" id="total-energy-section" style="display: none;">
            <h3><%= __("Total energy used")%></h3>
            <div class="graph-controls">
                <label>
                    <input type="checkbox" id="weekend-coloring-total" />
                    <span><%= __("Color weekends")%></span>
                </label>
            </div>
            <div id="graph-total" class="graph-container"></div>
        </div>

        <!-- Stacked Energy Breakdown Graph -->
        <div class="graph-section" id="stacked-section" style="display: none;">
            <h3><%= __("Energy breakdown (stacked)")%></h3>
            <div id="graph-stacked" class="graph-container"></div>
        </div>

        <!-- Energy Breakdown Table -->
        <div class="graph-section" id="breakdown-table-section" style="display: none;">
            <h3><%= __("Energy breakdown table")%></h3>
            <div class="graph-controls">
                <label>
                    <span><%= __("Year")%>:</span>
                    <select id="breakdown-year-select"></select>
                </label>
            </div>
            <div id="breakdown-table"></div>
        </div>


        <!-- Weather Data Graph -->
        <div class="graph-section" id="weather-section" style="display: none;">
            <h3><%= __("Weather data")%></h3>
            <div id="graph-weather" class="graph-container"></div>
        </div>
    </main>
    <script src="<%= asset('/assets/plotly.js') %>"></script>
    <script src="<%= asset('/assets/energy-consumption.js') %>"></script>
    <%- include('partials/energy-day-table') %>
    <script>
        let dateObjects = null;
        // Local day key of each bar when the aggregation is 'day'.
        let barDays = [];
        // Stored day summaries with readings, one per local day, sorted by day.
        let energyRows = null;
        const rowsByDay = new Map();
        let weatherData = null;
        let dataMetrics = {
            consumption: null,
            solar: null,
            batteryDischarging: null,
            batteryCharging: null,
            saved: null,
            introduced: null,
            totalEnergyUsed: null
        };
        
        const isWeekend = (date) => {
            const day = date.getDay();
            return day === 0 || day === 6; // Sunday = 0, Saturday = 6
        };
        
        // Keys follow local calendar days, like the stored day summaries.
        const getAggregationKey = (date, aggregation) => {
            const d = new Date(date);
            d.setHours(0, 0, 0, 0);
            
            switch(aggregation) {
                case 'day':
                    return localDayKey(d); // YYYY-MM-DD
                case 'week':
                    // Get Monday of the week
                    const day = d.getDay();
                    const monday = new Date(d);
                    monday.setDate(d.getDate() - day + (day === 0 ? -6 : 1)); // Adjust when day is Sunday
                    return localDayKey(monday);
                case 'month':
                    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`; // YYYY-MM
                case 'year':
                    return String(d.getFullYear()); // YYYY
                default:
                    return localDayKey(d);
            }
        };
        
        const getAggregationDate = (key, aggregation) => {
            switch(aggregation) {
                case 'day':
                    return parseLocalDay(key);
                case 'week':
                    return parseLocalDay(key); // Already Monday
                case 'month':
                    const [year, month] = key.split('-');
                    return new Date(parseInt(year), parseInt(month) - 1, 1);
                case 'year':
                    return new Date(parseInt(key), 0, 1);
                default:
                    return parseLocalDay(key);
            }
        };
        
        // Days without grid readings are stored too, but have nothing to draw.
        const setRows = (rows) => {
            rows.forEach(row => rowsByDay.set(row.day, row));
            energyRows = Array.from(rowsByDay.values())
                .filter(row => row.start_date)
                .sort((a, b) => a.day < b.day ? -1 : a.day > b.day ? 1 : 0);
        };

        // Selected duration as local calendar days (YYYY-MM-DD); an empty
        // field leaves that side of the range open.
        const selectedRange = () => ({
            start: document.getElementById('range-start').value,
            end: document.getElementById('range-end').value
        });

        const selectedData = () => {
            if (!energyRows) return null;
            const {start, end} = selectedRange();
            return energyRows.filter(entry => (!start || entry.day >= start) && (!end || entry.day <= end));
        };

        const aggregateData = (aggregation) => {
            const entries = selectedData();
            if (!entries) return null;

            const grouped = {};

            // Group data by aggregation key
            for (const entry of entries) {
                const key = aggregation === 'day' ? entry.day : getAggregationKey(parseLocalDay(entry.day), aggregation);
                
                if (!grouped[key]) {
                    grouped[key] = [];
                }
                grouped[key].push(window.energyConsumption.normalizeEntry(entry));
            }
            
            // Sort keys chronologically
            const sortedKeys = Object.keys(grouped).sort();
            const aggregatedDates = sortedKeys.map(key => getAggregationDate(key, aggregation));
            
            // One stored summary per day, so every aggregation is a plain sum.
            const aggregateFn = (arr) => {
                if (arr.some(value => !Number.isFinite(value))) return null;
                return window.energyConsumption.roundEnergy(arr.reduce((sum, val) => sum + val, 0));
            };
            
            const consumption = sortedKeys.map(key => {
                const entries = grouped[key];
                return aggregateFn(entries.map(e => e.consumption_on_network));
            });
            
            const solar = sortedKeys.map(key => {
                const entries = grouped[key];
                return aggregateFn(entries.map(e => e.solar_panel));
            });
            
            const batteryDischarging = sortedKeys.map(key =>
                aggregateFn(grouped[key].map(e => e.battery_discharging)));
            const batteryCharging = sortedKeys.map(key =>
                aggregateFn(grouped[key].map(e => e.battery_charging)));

            const saved = sortedKeys.map(key => {
                const entries = grouped[key];
                return aggregateFn(entries.map(window.energyConsumption.savedEnergy));
            });
            
            const introduced = sortedKeys.map(key => {
                const entries = grouped[key];
                return aggregateFn(entries.map(e => e.introduced_on_network));
            });
            
            const totalEnergyUsed = sortedKeys.map(key => {
                const entries = grouped[key];
                return aggregateFn(entries.map(e => e.house_consumption));
            });
            
            return {
                dates: aggregatedDates,
                days: aggregation === 'day' ? sortedKeys : [],
                consumption,
                solar,
                batteryDischarging,
                batteryCharging,
                saved,
                introduced,
                totalEnergyUsed
            };
        };
        
        const updateAllGraphs = (aggregation) => {
            const aggregated = aggregateData(aggregation);
            if (!aggregated) return;
            
            dateObjects = aggregated.dates;
            barDays = aggregated.days;
            dataMetrics.consumption = aggregated.consumption;
            dataMetrics.solar = aggregated.solar;
            dataMetrics.batteryDischarging = aggregated.batteryDischarging;
            dataMetrics.batteryCharging = aggregated.batteryCharging;
            dataMetrics.saved = aggregated.saved;
            dataMetrics.introduced = aggregated.introduced;
            dataMetrics.totalEnergyUsed = aggregated.totalEnergyUsed;
            
            // Recreate all graphs
            createGraph('graph-consumption', '<%= __("Consumption on network")%>', '<%= __("Consumption on network")%>', aggregated.consumption, 'consumption', 'weekend-coloring-consumption');
            createSolarGraph('graph-solar', '<%= __("Solar panel production energy")%>', '<%= __("Solar panel production energy")%>', aggregated.solar, 'weekend-coloring-solar', 'show-sunshine-solar');
            createGraph('graph-battery-discharging', '<%= __("Battery discharging energy")%>', '<%= __("Battery discharging energy")%>', aggregated.batteryDischarging, 'batteryDischarging', 'weekend-coloring-battery-discharging');
            createGraph('graph-battery-charging', '<%= __("Battery charging energy")%>', '<%= __("Battery charging energy")%>', aggregated.batteryCharging, 'batteryCharging', 'weekend-coloring-battery-charging');
            createGraph('graph-saved', '<%= __("Energy Saved")%>', '<%= __("Energy Saved")%>', aggregated.saved, 'saved', 'weekend-coloring-saved');
            createGraph('graph-introduced', '<%= __("Energy Introduced")%>', '<%= __("Energy Introduced")%>', aggregated.introduced, 'introduced', 'weekend-coloring-introduced');
            createGraph('graph-total', '<%= __("Total energy used")%>', '<%= __("Total energy used")%>', aggregated.totalEnergyUsed, 'total', 'weekend-coloring-total');
            createStackedGraph('graph-stacked', aggregated);
            ['graph-consumption', 'graph-solar', 'graph-battery-discharging', 'graph-battery-charging',
                'graph-saved', 'graph-introduced', 'graph-total', 'graph-stacked'].forEach(bindDayClick);
        };

        const showDay = (row) => {
            renderEnergyDay(document.getElementById('day-result'), row, (updated) => {
                setRows([updated]);
                applyDuration();
                showDay(updated);
            });
            document.getElementById('day-section').style.display = 'block';
        };

        // Clicking a bar of the day aggregation shows that day, with a recompute button.
        const bindDayClick = (containerId) => {
            const container = document.getElementById(containerId);
            if (!container || !container.on) return;
            if (container.removeAllListeners) container.removeAllListeners('plotly_click');
            container.on('plotly_click', (event) => {
                const day = event.points && event.points.length ? barDays[event.points[0].pointIndex] : null;
                if (day && rowsByDay.has(day)) showDay(rowsByDay.get(day));
            });
        };
        
        const calculateMovingAverage = (data, windowSize) => {
            const movingAverage = [];
            const effectiveWindowSize = Math.min(windowSize, Math.max(3, Math.floor(data.length / 10)));
            
            for (let i = 0; i < data.length; i++) {
                const start = Math.max(0, i - Math.floor(effectiveWindowSize / 2));
                const end = Math.min(data.length, i + Math.ceil(effectiveWindowSize / 2));
                const window = data.slice(start, end);
                const avg = window.some(value => !Number.isFinite(value)) ? null :
                    window.reduce((sum, val) => sum + val, 0) / window.length;
                movingAverage.push(avg);
            }
            return movingAverage;
        };
        
        const createWeatherGraph = (containerId, weatherDates, sunshineData, maxTempData) => {
            if (!weatherDates || !sunshineData || !maxTempData || weatherDates.length === 0) return;
            
            // Create dual y-axis graph: sunshine duration (left) and max temperature (right)
            const trace1 = {
                type: 'bar',
                x: weatherDates,
                y: sunshineData,
                name: '<%= __("Sunshine duration")%>',
                marker: { color: '#f39c12' },
                yaxis: 'y'
            };
            
            const trace2 = {
                type: 'scatter',
                mode: 'lines+markers',
                x: weatherDates,
                y: maxTempData,
                name: '<%= __("Max temperature")%>',
                line: { color: '#e74c3c', width: 2 },
                marker: { color: '#e74c3c', size: 4 },
                yaxis: 'y2'
            };
            
            // Get container width dynamically
            const container = document.getElementById(containerId);
            let containerWidth = 1000;
            
            if (container) {
                const parent = container.closest('.graph-section');
                if (parent && parent.offsetWidth > 0) {
                    containerWidth = parent.offsetWidth - 40;
                } else {
                    containerWidth = Math.min(window.innerWidth - 80, 1360);
                }
            } else {
                containerWidth = Math.min(window.innerWidth - 80, 1360);
            }
            
            const layout = {
                title: '<%= __("Weather data")%>',
                width: containerWidth,
                height: 400,
                xaxis: {
                    title: '<%= __("Date")%>',
                    type: 'date'
                },
                yaxis: {
                    title: '<%= __("Sunshine duration")%> (<%= __("hours")%>)',
                    side: 'left',
                    titlefont: { color: '#f39c12' },
                    tickfont: { color: '#f39c12' }
                },
                yaxis2: {
                    title: '<%= __("Max temperature")%> (°C)',
                    overlaying: 'y',
                    side: 'right',
                    titlefont: { color: '#e74c3c' },
                    tickfont: { color: '#e74c3c' }
                },
                autoscale: true,
                margin: { l: 60, r: 60, t: 40, b: 80 },
                legend: {
                    orientation: 'h',
                    y: -0.25,
                    x: 0.5,
                    xanchor: 'center'
                },
                autosize: false
            };
            
            Plotly.newPlot(containerId, [trace1, trace2], layout);
            
            // Handle window resize
            window.addEventListener('resize', function() {
                const updatedContainer = document.getElementById(containerId);
                if (updatedContainer) {
                    const updatedParent = updatedContainer.closest('.graph-section');
                    if (updatedParent && updatedParent.offsetWidth > 0) {
                        const newWidth = updatedParent.offsetWidth - 40;
                        Plotly.relayout(containerId, { width: newWidth });
                    }
                }
            });
        };
        
        const createStackedGraph = (containerId, metrics) => {
            if (!dateObjects || !metrics) return;

            // Charging and exported energy subtract from energy reaching the house.
            const traces = [
                { type: 'bar', x: dateObjects, y: metrics.consumption,
                    name: '<%= __("Consumption on network")%>', marker: { color: '#3498db' } },
                { type: 'bar', x: dateObjects, y: metrics.solar,
                    name: '<%= __("Solar panel production energy")%>', marker: { color: '#2ecc71' } },
                { type: 'bar', x: dateObjects, y: metrics.introduced,
                    name: '<%= __("Energy Introduced")%>', marker: { color: '#f39c12' } },
                { type: 'bar', x: dateObjects, y: metrics.batteryDischarging,
                    name: '<%= __("Battery discharging energy")%>', marker: { color: '#9b59b6' } },
                { type: 'bar', x: dateObjects,
                    y: metrics.batteryCharging.map(value => Number.isFinite(value) ? -value : null),
                    name: '<%= __("Battery charging energy")%>', marker: { color: '#e74c3c' } },
                { type: 'scatter', mode: 'lines+markers', x: dateObjects, y: metrics.totalEnergyUsed,
                    name: '<%= __("Total energy used")%>', line: { color: '#111827', width: 2 } }
            ];

            // Get container width dynamically
            const container = document.getElementById(containerId);
            let containerWidth = 1000;
            
            if (container) {
                const parent = container.closest('.graph-section');
                if (parent && parent.offsetWidth > 0) {
                    containerWidth = parent.offsetWidth - 40;
                } else {
                    containerWidth = Math.min(window.innerWidth - 80, 1360);
                }
            } else {
                containerWidth = Math.min(window.innerWidth - 80, 1360);
            }
            
            const layout = {
                title: '<%= __("Energy breakdown (stacked)")%>',
                width: containerWidth,
                height: 400,
                barmode: 'relative',
                xaxis: {
                    title: '<%= __("Date")%>',
                    type: 'date'
                },
                yaxis: {
                    title: '<%= __("Energy")%> (kWh)'
                },
                autoscale: true,
                margin: { l: 60, r: 20, t: 40, b: 80 },
                legend: {
                    orientation: 'h',
                    y: -0.25,
                    x: 0.5,
                    xanchor: 'center'
                },
                autosize: false
            };
            
            Plotly.newPlot(containerId, traces, layout);
            
            // Handle window resize
            window.addEventListener('resize', function() {
                const updatedContainer = document.getElementById(containerId);
                if (updatedContainer) {
                    const updatedParent = updatedContainer.closest('.graph-section');
                    if (updatedParent && updatedParent.offsetWidth > 0) {
                        const newWidth = updatedParent.offsetWidth - 40;
                        Plotly.relayout(containerId, { width: newWidth });
                    }
                }
            });
        };
        
        const createSolarGraph = (containerId, title, yAxisTitle, data, weekendCheckboxId, sunshineCheckboxId) => {
            // An empty duration still redraws, so no graph keeps a previous range.
            if (!dateObjects || !data) return;
            
            const weekendColoringEnabled = document.getElementById(weekendCheckboxId).checked;
            const showSunshine = document.getElementById(sunshineCheckboxId).checked;
            
            const barColors = dateObjects.map(date => {
                if (weekendColoringEnabled) {
                    return isWeekend(date) ? '#e67e22' : '#3498db';
                } else {
                    return '#3498db';
                }
            });
            
            const movingAverage = calculateMovingAverage(data, 7);
            
            const traces = [];
            
            // Bar trace for solar production
            traces.push({
                type: 'bar',
                x: dateObjects,
                y: data,
                marker: {
                    color: barColors
                },
                name: title + ' (kWh)',
                yaxis: 'y'
            });
            
            // Moving average line
            traces.push({
                type: 'scatter',
                mode: 'lines',
                x: dateObjects,
                y: movingAverage,
                line: {
                    color: '#e74c3c',
                    width: 2
                },
                name: '<%= __("Moving average")%>',
                yaxis: 'y'
            });
            
            // Sunshine duration line (if enabled)
            if (showSunshine && weatherData && weatherData.sunshineData && weatherData.sunshineData.length > 0) {
                // Match weather dates with energy dates
                const sunshineAligned = dateObjects.map(energyDate => {
                    // Find closest weather date
                    let closestIndex = -1;
                    let minDiff = Infinity;
                    
                    for (let i = 0; i < weatherData.weatherDates.length; i++) {
                        const diff = Math.abs(energyDate - weatherData.weatherDates[i]);
                        if (diff < minDiff) {
                            minDiff = diff;
                            closestIndex = i;
                        }
                    }
                    
                    if (closestIndex >= 0 && minDiff < 24 * 60 * 60 * 1000) { // Within 1 day
                        return weatherData.sunshineData[closestIndex];
                    }
                    return null;
                });
                
                traces.push({
                    type: 'scatter',
                    mode: 'markers',
                    x: dateObjects,
                    y: sunshineAligned,
                    marker: {
                        color: '#f39c12',
                        size: 6
                    },
                    name: '<%= __("Sunshine duration")%>',
                    yaxis: 'y2'
                });
            }
            
            // Get container width dynamically
            const container = document.getElementById(containerId);
            let containerWidth = 1000;
            
            if (container) {
                const parent = container.closest('.graph-section');
                if (parent && parent.offsetWidth > 0) {
                    containerWidth = parent.offsetWidth - 40;
                } else {
                    containerWidth = Math.min(window.innerWidth - 80, 1360);
                }
            } else {
                containerWidth = Math.min(window.innerWidth - 80, 1360);
            }
            
            const layout = {
                title: title,
                width: containerWidth,
                height: 400,
                xaxis: {
                    title: '<%= __("Date")%>',
                    type: 'date'
                },
                yaxis: {
                    title: yAxisTitle + ' (kWh)',
                    side: 'left',
                    titlefont: { color: '#3498db' },
                    tickfont: { color: '#3498db' }
                },
                autoscale: true,
                margin: { l: 60, r: showSunshine && weatherData && weatherData.sunshineData ? 60 : 20, t: 40, b: 80 },
                legend: {
                    orientation: 'h',
                    y: -0.25,
                    x: 0.5,
                    xanchor: 'center'
                },
                autosize: false
            };
            
            // Add yaxis2 only if sunshine is enabled
            if (showSunshine && weatherData && weatherData.sunshineData) {
                layout.yaxis2 = {
                    title: '<%= __("Sunshine duration")%> (<%= __("hours")%>)',
                    overlaying: 'y',
                    side: 'right',
                    titlefont: { color: '#f39c12' },
                    tickfont: { color: '#f39c12' }
                };
            }
            
            Plotly.newPlot(containerId, traces, layout);
            
            // Handle window resize
            window.addEventListener('resize', function() {
                const updatedContainer = document.getElementById(containerId);
                if (updatedContainer) {
                    const updatedParent = updatedContainer.closest('.graph-section');
                    if (updatedParent && updatedParent.offsetWidth > 0) {
                        const newWidth = updatedParent.offsetWidth - 40;
                        Plotly.relayout(containerId, { width: newWidth });
                    }
                }
            });
            
            // Add event listeners
            document.getElementById(weekendCheckboxId).addEventListener('change', function(e) {
                const colors = dateObjects.map(date => {
                    if (e.target.checked) {
                        return isWeekend(date) ? '#e67e22' : '#3498db';
                    } else {
                        return '#3498db';
                    }
                });
                Plotly.restyle(containerId, {
                    'marker.color': [colors]
                }, [0]);
            });
            
            document.getElementById(sunshineCheckboxId).addEventListener('change', function(e) {
                // Recreate graph with updated sunshine visibility
                createSolarGraph(containerId, title, yAxisTitle, data, weekendCheckboxId, sunshineCheckboxId);
            });
        };
        
        const createGraph = (containerId, title, yAxisTitle, data, metricName, weekendCheckboxId) => {
            // An empty duration still redraws, so no graph keeps a previous range.
            if (!dateObjects || !data) return;
            
            const weekendColoringEnabled = document.getElementById(weekendCheckboxId).checked;
            const barColors = dateObjects.map(date => {
                if (weekendColoringEnabled) {
                    return isWeekend(date) ? '#e67e22' : '#3498db';
                } else {
                    return '#3498db';
                }
            });
            
            const movingAverage = calculateMovingAverage(data, 7);
            
            const barTrace = {
                type: 'bar',
                x: dateObjects,
                y: data,
                marker: {
                    color: barColors
                },
                name: title + ' (kWh)'
            };
            
            const lineTrace = {
                type: 'scatter',
                mode: 'lines',
                x: dateObjects,
                y: movingAverage,
                line: {
                    color: '#e74c3c',
                    width: 2
                },
                name: '<%= __("Moving average")%>'
            };
            
            // Get container width dynamically - wait for container to be visible
            const container = document.getElementById(containerId);
            let containerWidth = 1000; // default fallback
            
            if (container) {
                // If container is not visible yet, use parent width
                const parent = container.closest('.graph-section');
                if (parent && parent.offsetWidth > 0) {
                    containerWidth = parent.offsetWidth - 40; // subtract padding
                } else {
                    containerWidth = Math.min(window.innerWidth - 80, 1360); // account for main padding
                }
            } else {
                containerWidth = Math.min(window.innerWidth - 80, 1360);
            }
            
            const layout = {
                title: title,
                width: containerWidth,
                height: 400,
                xaxis: {
                    title: '<%= __("Date")%>',
                    type: 'date'
                },
                yaxis: {
                    title: yAxisTitle + ' (kWh)'
                },
                autoscale: true,
                margin: { l: 60, r: 20, t: 40, b: 80 },
                legend: {
                    orientation: 'h',
                    y: -0.25,
                    x: 0.5,
                    xanchor: 'center'
                },
                autosize: false
            };
            
            Plotly.newPlot(containerId, [barTrace, lineTrace], layout);
            
            // Handle window resize
            window.addEventListener('resize', function() {
                const updatedContainer = document.getElementById(containerId);
                if (updatedContainer) {
                    const updatedParent = updatedContainer.closest('.graph-section');
                    if (updatedParent && updatedParent.offsetWidth > 0) {
                        const newWidth = updatedParent.offsetWidth - 40;
                        Plotly.relayout(containerId, { width: newWidth });
                    }
                }
            });
            
            // Add event listener for weekend coloring toggle
            document.getElementById(weekendCheckboxId).addEventListener('change', function(e) {
                const colors = dateObjects.map(date => {
                    if (e.target.checked) {
                        return isWeekend(date) ? '#e67e22' : '#3498db';
                    } else {
                        return '#3498db';
                    }
                });
                Plotly.restyle(containerId, {
                    'marker.color': [colors]
                }, [0]);
            });
        };
        
        const breakdownMetrics = [
            { key: 'consumption_on_network', label: '<%= __("Consumption on network")%>' },
            { key: 'solar_panel', label: '<%= __("Solar panel production energy")%>' },
            { key: 'battery_discharging', label: '<%= __("Battery discharging energy")%>' },
            { key: 'battery_charging', label: '<%= __("Battery charging energy")%>' },
            { key: 'house_consumption', label: '<%= __("Total energy used")%>' },
            { key: 'introduced_on_network', label: '<%= __("Energy Introduced")%>' }
        ];

        const months = ['<%= __("January")%>', '<%= __("February")%>', '<%= __("March")%>', '<%= __("April")%>', '<%= __("May")%>', '<%= __("June")%>', '<%= __("July")%>', '<%= __("August")%>', '<%= __("September")%>', '<%= __("October")%>', '<%= __("November")%>', '<%= __("December")%>'];

        const localYear = (date) => date.getFullYear();
        const localMonthKey = (date) => date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0');
        const localDayKey = (date) => localMonthKey(date) + '-' + String(date.getDate()).padStart(2, '0');
        const parseLocalDay = (key) => {
            const [year, month, day] = key.split('-').map(Number);
            return new Date(year, month - 1, day);
        };
        const fmtSum = window.energyConsumption.roundEnergy;

        const renderBreakdownTable = () => {
            const select = document.getElementById('breakdown-year-select');
            const selectedYear = select.value ? parseInt(select.value, 10) : null;
            const container = document.getElementById('breakdown-table');
            container.innerHTML = '';

            if (!energyRows || energyRows.length === 0) return;

            const grouped = {};
            selectedData().forEach(entry => {
                const dateObj = new Date(entry.start_date);
                if (selectedYear && localYear(dateObj) !== selectedYear) return;
                const key = selectedYear ? localMonthKey(dateObj) : String(localYear(dateObj));
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(window.energyConsumption.normalizeEntry(entry));
            });

            const sortedKeys = Object.keys(grouped).sort();

            const table = document.createElement('table');
            const thead = document.createElement('thead');
            const hr = document.createElement('tr');
            const th0 = document.createElement('th');
            th0.textContent = selectedYear ? '<%= __("Month")%>' : '<%= __("Year")%>';
            hr.appendChild(th0);
            breakdownMetrics.forEach(m => {
                const th = document.createElement('th');
                th.textContent = m.label + ' (kWh)';
                hr.appendChild(th);
            });
            thead.appendChild(hr);
            table.appendChild(thead);

            const tbody = document.createElement('tbody');
            sortedKeys.forEach(key => {
                const tr = document.createElement('tr');
                const labelCell = document.createElement('td');
                if (selectedYear) {
                    const parts = key.split('-');
                    labelCell.textContent = months[parseInt(parts[1], 10) - 1] + ' ' + parseInt(parts[0], 10);
                } else {
                    labelCell.textContent = key;
                }
                tr.appendChild(labelCell);
                breakdownMetrics.forEach(m => {
                    const values = grouped[key].map(e => e[m.key]);
                    const sum = values.some(value => !Number.isFinite(value)) ? null :
                        values.reduce((acc, value) => acc + value, 0);
                    const td = document.createElement('td');
                    td.textContent = sum === null ? '<%= __("Unavailable")%>' : fmtSum(sum);
                    tr.appendChild(td);
                });
                tbody.appendChild(tr);
            });
            table.appendChild(tbody);
            container.appendChild(table);
        };

        // The years offered follow the selected duration; the chosen year is
        // kept while it remains in range.
        const fillBreakdownYears = () => {
            const select = document.getElementById('breakdown-year-select');
            const previous = select.value;
            const years = new Set();
            selectedData().forEach(entry => years.add(localYear(new Date(entry.start_date))));

            select.innerHTML = '';
            const empty = document.createElement('option');
            empty.value = '';
            empty.textContent = '-- <%= __("All years")%> --';
            select.appendChild(empty);
            Array.from(years).sort().forEach(year => {
                const opt = document.createElement('option');
                opt.value = year;
                opt.textContent = year;
                select.appendChild(opt);
            });
            select.value = years.has(parseInt(previous, 10)) ? previous : '';
        };

        const setupBreakdownTable = () => {
            fillBreakdownYears();
            document.getElementById('breakdown-year-select').addEventListener('change', renderBreakdownTable);

            document.getElementById('breakdown-table-section').style.display = 'block';
            renderBreakdownTable();
        };

        const loadSelectedWeather = () => {
            const {start, end} = selectedRange();
            if (start && end) loadWeatherData(parseLocalDay(start), parseLocalDay(end));
        };

        const applyDuration = () => {
            updateAllGraphs(document.getElementById('aggregation-select').value);
            fillBreakdownYears();
            renderBreakdownTable();
            loadSelectedWeather();
        };

        // '#duration=N': the last N days, today included.
        const durationFromHash = () => {
            const match = /^#(?:.*&)?duration=(\d{1,4})(?:&|$)/.exec(window.location.hash || '');
            const days = match ? parseInt(match[1], 10) : 0;
            return days > 0 ? days : null;
        };

        const rangeForDuration = (days) => {
            const today = new Date();
            const start = new Date(today.getFullYear(), today.getMonth(), today.getDate() - (days - 1));
            return {start: localDayKey(start), end: localDayKey(today)};
        };

        let fillRequest = 0;

        // Computes the stale days one after another, then redraws once.
        const fillStaleDays = async (days) => {
            const request = ++fillRequest;
            const progress = document.getElementById('fill-progress');
            for (let i = 0; i < days.length; i++) {
                if (request !== fillRequest) return;
                progress.textContent = '<%= __("Computing missing days")%> ' + (i + 1) + '/' + days.length;
                progress.style.display = 'block';
                try {
                    const response = await fetch('/api/data/energy/day/' + days[i]);
                    setRows([await response.json()]);
                } catch (error) {
                    console.error('Error:', error);
                }
            }
            if (request !== fillRequest) return;
            progress.style.display = 'none';
            if (days.length) applyDuration();
        };

        // Without a range: the whole stored period, up to today.
        const loadRange = (range) => {
            const query = range.start ? '?start=' + range.start + '&end=' + range.end : '';
            return fetch('/api/data/energy/days' + query)
                .then(response => response.json())
                .then(result => {
                    setRows(result.days);
                    const today = localDayKey(new Date());
                    document.getElementById('range-start').value = range.start ||
                        (result.days.length ? result.days[0].day : today);
                    document.getElementById('range-end').value = range.end || today;
                    applyDuration();
                    // The graphs show the stored days while the others are computed.
                    fillStaleDays(result.stale);
                });
        };

        const loadHashRange = () => {
            const duration = durationFromHash();
            return loadRange(duration ? rangeForDuration(duration) : {});
        };

        const setupDurationControls = () => {
            const start = document.getElementById('range-start');
            const end = document.getElementById('range-end');
            start.max = end.max = localDayKey(new Date());

            // Moving one bound past the other moves the other along with it.
            const change = () => loadRange({start: start.value, end: end.value});
            start.addEventListener('change', () => {
                if (start.value && end.value && start.value > end.value) end.value = start.value;
                if (start.value && end.value) change();
            });
            end.addEventListener('change', () => {
                if (start.value && end.value && start.value > end.value) start.value = end.value;
                if (start.value && end.value) change();
            });
            document.getElementById('range-reset').addEventListener('click', () => loadRange({}));
            window.addEventListener('hashchange', loadHashRange);
        };

        const loadData = () => {
            setupDurationControls();
            loadHashRange().then(() => {
                // Show all sections and hide loader
                document.getElementById('loader').style.display = 'none';
                document.getElementById('global-controls').style.display = 'flex';
                document.getElementById('consumption-section').style.display = 'block';
                document.getElementById('solar-section').style.display = 'block';
                document.getElementById('battery-discharging-section').style.display = 'block';
                document.getElementById('battery-charging-section').style.display = 'block';
                document.getElementById('saved-section').style.display = 'block';
                document.getElementById('introduced-section').style.display = 'block';
                document.getElementById('total-energy-section').style.display = 'block';
                document.getElementById('stacked-section').style.display = 'block';

                setupBreakdownTable();
                
                // Add event listener for aggregation change
                document.getElementById('aggregation-select').addEventListener('change', function(e) {
                    updateAllGraphs(e.target.value);
                    loadSelectedWeather();
                });
            }).catch(error => {
                console.error('Error:', error);
            });
        }

        let weatherRequest = 0;
        
        const loadWeatherData = (startDate, endDate) => {
            if (!startDate || !endDate) {
                return;
            }
            
            // Get location from config (passed from server)
            const latitude = '<%= config.latitude || "" %>';
            const longitude = '<%= config.longitude || "" %>';
            const timezone = '<%= config.timezone || "auto" %>';
            
            if (!latitude || !longitude) {
                console.error('Weather location not configured');
                return;
            }
            
            // Add a small buffer to ensure we get all data
            const bufferStart = new Date(startDate);
            bufferStart.setDate(bufferStart.getDate() - 1);
            const bufferEnd = new Date(endDate);
            bufferEnd.setDate(bufferEnd.getDate() + 1);
            
            const startStr = bufferStart.toISOString().split('T')[0];
            const endStr = bufferEnd.toISOString().split('T')[0];
            
            // Fetch directly from Open-Meteo Archive API
            const url = `https://archive-api.open-meteo.com/v1/archive?latitude=${latitude}&longitude=${longitude}&start_date=${startStr}&end_date=${endStr}&daily=temperature_2m_max,temperature_2m_min,sunshine_duration&timezone=${timezone}`;
            
            const request = ++weatherRequest;
            const fetchWeatherData = fetch(url)
                .then(response => response.json())
                .catch(error => {
                    console.error('Error fetching weather data:', error);
                    return null;
                });

            fetchWeatherData.then(weatherResponse => {
                // A later duration or aggregation change supersedes this response.
                if (request !== weatherRequest) return;
                if (!weatherResponse || !weatherResponse.daily || !weatherResponse.daily.time || weatherResponse.daily.time.length === 0) {
                    // No weather data available for this range: hide the previous one
                    document.getElementById('weather-section').style.display = 'none';
                    return;
                }
                
                // Process Open-Meteo response format
                const processedWeatherData = [];
                for (let i = 0; i < weatherResponse.daily.time.length; i++) {
                    const dateObj = parseLocalDay(weatherResponse.daily.time[i]);
                    const sunshineDurationSeconds = weatherResponse.daily.sunshine_duration[i] || 0;
                    processedWeatherData.push({
                        date: dateObj,
                        sunshine_duration: sunshineDurationSeconds / 3600, // Convert seconds to hours
                        max_temp: weatherResponse.daily.temperature_2m_max[i] || 0,
                        min_temp: weatherResponse.daily.temperature_2m_min[i] || 0
                    });
                }
                
                // Group by date (using same aggregation as energy data)
                const aggregationSelect = document.getElementById('aggregation-select');
                if (!aggregationSelect) return;
                
                const aggregation = aggregationSelect.value;
                const weatherGrouped = {};
                
                for (const entry of processedWeatherData) {
                    const key = getAggregationKey(entry.date, aggregation);
                    if (!weatherGrouped[key]) {
                        weatherGrouped[key] = [];
                    }
                    weatherGrouped[key].push(entry);
                }
                
                // Aggregate weather data
                const sortedWeatherKeys = Object.keys(weatherGrouped).sort();
                const weatherDates = sortedWeatherKeys.map(key => getAggregationDate(key, aggregation));
                
                const aggregateFn = aggregation === 'day' ? 
                    (arr) => Math.max(...arr) : 
                    (arr) => arr.reduce((sum, val) => sum + val, 0) / arr.length; // Average for aggregated periods
                
                const sunshineData = sortedWeatherKeys.map(key => {
                    const entries = weatherGrouped[key];
                    return aggregateFn(entries.map(e => e.sunshine_duration));
                });
                
                const maxTempData = sortedWeatherKeys.map(key => {
                    const entries = weatherGrouped[key];
                    return aggregateFn(entries.map(e => e.max_temp));
                });
                
                // Store weather data for use in solar graph
                weatherData = {
                    weatherDates: weatherDates,
                    sunshineData: sunshineData,
                    maxTempData: maxTempData
                };
                
                // Create weather graph
                if (weatherDates.length > 0) {
                    createWeatherGraph('graph-weather', weatherDates, sunshineData, maxTempData);
                    document.getElementById('weather-section').style.display = 'block';
                    
                    // Update solar graph if it exists and sunshine checkbox is checked
                    const sunshineCheckbox = document.getElementById('show-sunshine-solar');
                    if (sunshineCheckbox && sunshineCheckbox.checked && dataMetrics.solar) {
                        createSolarGraph('graph-solar', '<%= __("Solar panel production energy")%>', '<%= __("Solar panel production energy")%>', dataMetrics.solar, 'weekend-coloring-solar', 'show-sunshine-solar');
                    }
                }
            });
        }
        
        window.addEventListener('load', loadData);
    </script>
      <script src="<%= asset('/assets/nav.js') %>"></script>
</body>
</html>
