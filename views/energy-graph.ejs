<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name=viewport content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/styles.css">
    <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100%;
            height: 100%;
            background: #f8f8f8;
            font-family: sans-serif;
        }

        header {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 10vh;
        }

        .title {
            font-size: 60px;
        }

        main {
            height: 80vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 100%;
        }
        .loader {
            border: 16px solid #f3f3f3; 
            border-top: 16px solid #3498db; 
            border-radius: 50%;
            width: 120px;
            height: 120px;
            animation: spin 2s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .controls {
            margin: 20px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .controls label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 16px;
        }
        .controls input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
    </style>
    <title>Solar panel watch | <%= __('Energy graph')%></title>
  </head>
  <body>
    <header>
      <h2 class="title">Solar panel watch</h2>
    </header>
    <main>
        <div id="loader" class="loader"></div>
        <div class="controls">
            <label>
                <input type="checkbox" id="weekend-coloring" />
                <span><%= __("Color weekends")%></span>
            </label>
        </div>
        <div id="graphs-container"></div>
    </main>
    <script src="/assets/plotly.js"></script>
    <script>
        let dateObjects = null;
        let maxConsumption = null;
        
        const isWeekend = (date) => {
            const day = date.getDay();
            return day === 0 || day === 6; // Sunday = 0, Saturday = 6
        };
        
        const updateBarColors = (weekendColoringEnabled) => {
            if (!dateObjects || !maxConsumption) return;
            
            const colors = dateObjects.map(date => {
                if (weekendColoringEnabled) {
                    return isWeekend(date) ? '#e67e22' : '#3498db'; // Orange for weekends, blue for weekdays
                } else {
                    return '#3498db'; // Default blue for all
                }
            });
            
            Plotly.restyle('graphs-container', {
                'marker.color': [colors]
            }, [0]); // Update first trace (bar chart)
        };
        
        const loadData = () => {
            const fetchData = fetch('/api/data/energy-request-hist/')
                .then(response => response.json())
                .catch(error => {
                    console.error('Error:', error);
                });

            fetchData.then(jsonData => {
                // Flatten the data from each calculation
                const flattened = [];
                for (const el of jsonData) {
                    flattened.push(...el.result);
                }
                
                // Add date key (as Date object) and formatted date string to each element
                for (const el of flattened) {
                    const dateObj = new Date(el.start_date);
                    // Set time to midnight for grouping by day
                    dateObj.setHours(0, 0, 0, 0);
                    el.dateObj = dateObj;
                    const day = String(dateObj.getDate()).padStart(2, '0');
                    const month = String(dateObj.getMonth() + 1).padStart(2, '0');
                    const year = String(dateObj.getFullYear()).slice(-2);
                    el.date = `${day}-${month}-${year}`;
                }

                // Group by date and find max consumption_on_network
                const filtered = {};
                
                for (const entry of flattened) {
                    // Use ISO date string as key for proper grouping
                    const dateKey = entry.dateObj.toISOString().split('T')[0];
                    if (!filtered[dateKey]) {
                        filtered[dateKey] = [];
                    }
                    filtered[dateKey].push(entry);
                }
                
                // Sort dates chronologically and get max consumption for each date
                const sortedDates = Object.keys(filtered).sort();
                dateObjects = sortedDates.map(dateStr => new Date(dateStr));
                maxConsumption = sortedDates.map(dateStr => {
                    const entries = filtered[dateStr];
                    return Math.max(...entries.map(e => e.consumption_on_network));
                });
                
                // Calculate moving average (using a window of 7 days, or adaptive based on data size)
                const windowSize = Math.min(7, Math.max(3, Math.floor(maxConsumption.length / 10)));
                const movingAverage = [];
                
                for (let i = 0; i < maxConsumption.length; i++) {
                    const start = Math.max(0, i - Math.floor(windowSize / 2));
                    const end = Math.min(maxConsumption.length, i + Math.ceil(windowSize / 2));
                    const window = maxConsumption.slice(start, end);
                    const avg = window.reduce((sum, val) => sum + val, 0) / window.length;
                    movingAverage.push(avg);
                }
                
                // Determine bar colors based on weekend coloring setting
                const weekendColoringEnabled = document.getElementById('weekend-coloring').checked;
                const barColors = dateObjects.map(date => {
                    if (weekendColoringEnabled) {
                        return isWeekend(date) ? '#e67e22' : '#3498db'; // Orange for weekends, blue for weekdays
                    } else {
                        return '#3498db'; // Default blue for all
                    }
                });
                
                // Create bar chart
                const barTrace = {
                    type: 'bar',
                    x: dateObjects,
                    y: maxConsumption,
                    marker: {
                        color: barColors
                    },
                    name: '<%= __("Max consumption on network")%> (kWh)'
                };
                
                // Create moving average line
                const lineTrace = {
                    type: 'scatter',
                    mode: 'lines',
                    x: dateObjects,
                    y: movingAverage,
                    line: {
                        color: '#e74c3c',
                        width: 2
                    },
                    name: '<%= __("Moving average")%>'
                };
                
                const layout = {
                    title: '<%= __("Energy consumption over time")%>',
                    width: window.innerWidth,
                    height: window.innerHeight * 0.8,
                    xaxis: {
                        title: '<%= __("Date")%>',
                        type: 'date'
                    },
                    yaxis: {
                        title: '<%= __("Consumption on network")%> (kWh)'
                    },
                    autoscale: true
                };
                
                Plotly.newPlot('graphs-container', [barTrace, lineTrace], layout);
                document.getElementById('loader').style.display = 'none';
                
                // Add event listener for weekend coloring toggle
                document.getElementById('weekend-coloring').addEventListener('change', function(e) {
                    updateBarColors(e.target.checked);
                });
            });
        }
        window.addEventListener('load', loadData);
    </script>
  </body>
</html>

