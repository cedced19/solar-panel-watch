<% const number = new Intl.NumberFormat(locale); %>
<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= __('Nomenclature description') %>">
    <link rel="stylesheet" href="<%= asset('/assets/styles.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/main_page.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/pages.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/nomenclature.css') %>">
    <link href="/favicon.ico" rel="shortcut icon" type="image/x-icon">
    <title>Solar Panel Watch | <%= __('Nomenclature') %></title>
  </head>
  <body class="dashboard-page nomenclature-page">
    <svg class="nomenclature-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0">
      <defs>
        <symbol id="nomenclature-solar-icon" viewBox="0 0 64 64">
          <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="47" cy="13" r="6"/><path d="M47 2v2m0 18v2M36 13h-2m26 0h2M39 5l-2-2m18 18 2 2M55 5l2-2"/>
            <path d="m11 25-6 24h47l-6-24H11Z"/><path d="m23 25-2 24m14-24 2 24M8 37h41M28 49v9m-11 0h22"/>
          </g>
        </symbol>
        <symbol id="nomenclature-grid-icon" viewBox="0 0 64 64">
          <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="m19 59 9-53h8l9 53M16 21h32M12 34h40M21 49h22M27 21l13 13m-13 0 16 15M37 21 24 34m13 0L21 49"/>
            <path d="M16 21v5m32-5v5M12 34v6m40-6v6M15 59h8m18 0h8"/>
          </g>
        </symbol>
        <symbol id="nomenclature-battery-icon" viewBox="0 0 64 64">
          <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="15" y="13" width="34" height="45" rx="6"/><path d="M25 13V6h14v7"/>
            <path d="m34 23-9 15h9l-4 12 10-16h-9l3-11Z"/>
          </g>
        </symbol>
        <symbol id="nomenclature-home-icon" viewBox="0 0 64 64">
          <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="m7 29 25-21 25 21M13 26v31h38V26M26 57V39h12v18"/><rect x="20" y="26" width="7" height="7" rx="1"/><rect x="37" y="26" width="7" height="7" rx="1"/>
          </g>
        </symbol>
        <symbol id="nomenclature-clock-icon" viewBox="0 0 64 64">
          <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="32" r="23"/><path d="M32 17v16l11 7"/></g>
        </symbol>
        <symbol id="nomenclature-bolt-icon" viewBox="0 0 64 64">
          <path d="m36 5-22 30h17l-3 24 22-32H33l3-22Z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        </symbol>
      </defs>
    </svg>
    <main class="dashboard-shell nomenclature-shell" id="content">
      <header class="dashboard-header nomenclature-header">
        <a class="nomenclature-brand" href="/">Solar Panel Watch<span class="nomenclature-brand-dot" aria-hidden="true"></span></a>
        <div class="nomenclature-header-actions">
          <a class="nav-btn" href="/">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 10 9-7 9 7v11H3V10Z"/><path d="M9 21v-8h6v8"/></svg>
            <span><%= __('Home') %></span>
          </a>
          <nav class="nomenclature-language" aria-label="<%= __('Nomenclature language') %>">
            <a href="/nomenclature/?lang=fr" lang="fr" hreflang="fr"<% if (locale === 'fr') { %> aria-current="page"<% } %>><%= __('Nomenclature French') %></a>
            <a href="/nomenclature/?lang=en" lang="en" hreflang="en"<% if (locale === 'en') { %> aria-current="page"<% } %>><%= __('Nomenclature English') %></a>
          </nav>
        </div>
      </header>

      <section class="nomenclature-hero" aria-labelledby="nomenclature-title">
        <div class="nomenclature-intro">
          <p class="nomenclature-eyebrow"><span aria-hidden="true">↗</span> <%= __('Nomenclature guide') %></p>
          <h1 id="nomenclature-title"><%= __('Nomenclature') %></h1>
          <p class="nomenclature-headline"><%= __('Nomenclature headline') %></p>
          <p class="nomenclature-lead"><%= __('Nomenclature description') %></p>
          <nav class="nomenclature-jump-links" aria-label="<%= __('Nomenclature contents') %>">
            <a href="#flows"><span aria-hidden="true">01</span> <%= __('Nomenclature flows link') %></a>
            <a href="#units"><span aria-hidden="true">02</span> <%= __('Nomenclature units link') %></a>
            <a href="#dashboard-terms"><span aria-hidden="true">03</span> <%= __('Nomenclature dashboard link') %></a>
            <a href="#activation-logic"><span aria-hidden="true">04</span> <%= __('Nomenclature logic link') %></a>
          </nav>
          <div class="nomenclature-storage-note">
            <svg class="nomenclature-note-icon" viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-battery-icon"/></svg>
            <p><strong><%= __('Nomenclature storage title') %></strong><span><%= __('Nomenclature storage description') %></span></p>
          </div>
        </div>
        <figure class="nomenclature-flow-card">
          <figcaption><span class="nomenclature-eyebrow"><%= __('Nomenclature diagram eyebrow') %></span><strong><%= __('Nomenclature diagram heading') %></strong></figcaption>
          <svg class="nomenclature-flow-svg" viewBox="0 0 440 570" role="img" aria-labelledby="nomenclature-flow-title nomenclature-flow-description">
            <title id="nomenclature-flow-title"><%= __('Nomenclature diagram title') %></title>
            <desc id="nomenclature-flow-description"><%= __('Nomenclature diagram description') %></desc>
            <defs>
              <marker id="nomenclature-arrow-solar" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" fill="#2b855e"/></marker>
              <marker id="nomenclature-arrow-grid" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" fill="#536675"/></marker>
              <marker id="nomenclature-arrow-house" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" fill="#3668b4"/></marker>
              <marker id="nomenclature-arrow-charge" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" fill="#996523"/></marker>
              <marker id="nomenclature-arrow-discharge" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" fill="#7a56ad"/></marker>
            </defs>
            <g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M98 174v77q0 19 19 19h78" stroke="#2b855e" marker-end="url(#nomenclature-arrow-solar)"/>
              <path d="M333 174v64q0 19-19 19h-69" stroke="#536675" marker-end="url(#nomenclature-arrow-grid)"/>
              <path d="M245 285h127q14 0 14-14v-97" stroke="#536675" stroke-dasharray="5 6" marker-end="url(#nomenclature-arrow-grid)"/>
              <path d="M195 289h-78q-19 0-19 19v90" stroke="#3668b4" marker-end="url(#nomenclature-arrow-house)"/>
              <path d="M245 304h69q19 0 19 19v75" stroke="#996523" marker-end="url(#nomenclature-arrow-charge)"/>
              <path d="M386 398v-63q0-13-13-13H246" stroke="#7a56ad" marker-end="url(#nomenclature-arrow-discharge)"/>
            </g>
            <g class="nomenclature-diagram-label" text-anchor="middle">
              <text x="151" y="213" fill="#246e4f"><%= __('Nomenclature arrow solar') %></text>
              <text x="278" y="211" fill="#405463"><%= __('Nomenclature arrow import') %></text>
              <text x="338" y="282" fill="#405463" class="nomenclature-arrow-label-background"><%= __('Nomenclature arrow export') %></text>
              <text x="157" y="345" fill="#285390"><%= __('Nomenclature arrow household') %></text>
              <text x="286" y="355" fill="#875618"><%= __('Nomenclature arrow charge') %></text>
              <text x="323" y="385" fill="#69449c" text-anchor="end"><%= __('Nomenclature arrow discharge') %></text>
            </g>
            <circle cx="220" cy="285" r="26" fill="#fff" stroke="#d9dfdc" stroke-width="2"/>
            <path d="m223 268-13 19h12l-3 14 12-20h-11l3-13Z" fill="#365245"/>
            <g class="nomenclature-diagram-node nomenclature-solar">
              <rect x="20" y="28" width="155" height="145" rx="22" fill="#eef7ef" stroke="#d1e7d6"/>
              <svg x="73" y="44" width="50" height="50" viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-solar-icon"/></svg>
              <text x="98" y="119"><%= __('Nomenclature solar short') %></text>
              <text class="nomenclature-node-caption" x="98" y="144"><%= __('Nomenclature produces') %></text>
            </g>
            <g class="nomenclature-diagram-node nomenclature-grid">
              <rect x="265" y="28" width="155" height="145" rx="22" fill="#f0f3f4" stroke="#dce3e6"/>
              <svg x="317" y="44" width="50" height="50" viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-grid-icon"/></svg>
              <text x="343" y="119"><%= __('Nomenclature grid short') %></text>
              <text class="nomenclature-node-caption" x="343" y="144"><%= __('Nomenclature exchanges') %></text>
            </g>
            <g class="nomenclature-diagram-node nomenclature-house">
              <rect x="20" y="400" width="155" height="145" rx="22" fill="#edf3fb" stroke="#d2dff0"/>
              <svg x="73" y="416" width="50" height="50" viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-home-icon"/></svg>
              <text x="98" y="490"><%= __('Nomenclature house short') %></text>
              <text class="nomenclature-node-caption" x="98" y="516"><%= __('Nomenclature uses') %></text>
            </g>
            <g class="nomenclature-diagram-node nomenclature-battery">
              <rect x="265" y="400" width="155" height="145" rx="22" fill="#f5effb" stroke="#e3d8f0"/>
              <svg x="317" y="416" width="50" height="50" viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-battery-icon"/></svg>
              <text x="343" y="490"><%= __('Nomenclature battery short') %></text>
              <text class="nomenclature-node-caption" x="343" y="516"><%= __('Nomenclature stores') %></text>
            </g>
          </svg>
          <p class="nomenclature-diagram-note"><%= __('Nomenclature diagram note') %></p>
        </figure>
      </section>

      <section class="nomenclature-section" id="flows" aria-labelledby="nomenclature-flows-title">
        <div class="nomenclature-section-heading"><span class="nomenclature-section-number" aria-hidden="true">01</span><div><h2 id="nomenclature-flows-title"><%= __('Nomenclature flows title') %></h2><p><%= __('Nomenclature flows subtitle') %></p></div></div>
        <div class="nomenclature-term-grid">
          <% for (const term of [
            { name: 'grid', title: 'Nomenclature grid term', description: 'Nomenclature grid description', label: 'Network power' },
            { name: 'solar', title: 'Nomenclature solar term', description: 'Nomenclature solar description', label: 'Solar panel production' },
            { name: 'battery', title: 'Nomenclature battery term', description: 'Nomenclature battery description', label: null },
            { name: 'house', title: 'Nomenclature house term', description: 'Nomenclature house description', label: 'Total Power' }
          ]) { %>
            <article class="nomenclature-term-card nomenclature-<%= term.name %>">
              <svg class="nomenclature-term-icon" viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-<%= term.name === 'house' ? 'home' : term.name %>-icon"/></svg>
              <h3><%= __(term.title) %></h3>
              <p><%= __(term.description) %></p>
              <p class="nomenclature-field-label"><%= __('Nomenclature graph label') %>: <strong><%= __(term.label || 'Battery discharging power') %><% if (!term.label) { %> / <%= __('Battery charging power') %><% } %></strong></p>
            </article>
          <% } %>
        </div>
        <div class="nomenclature-equation-card">
          <p class="nomenclature-eyebrow"><%= __('Nomenclature rule eyebrow') %></p>
          <h3><%= __('Nomenclature rule title') %></h3>
          <p><%= __('Nomenclature rule context') %></p>
          <div class="nomenclature-formula" aria-label="<%= __('Nomenclature formula spoken') %>">
            <span class="nomenclature-formula-term nomenclature-house"><%= __('Nomenclature house short') %><small><%= __('Nomenclature household use') %></small></span>
            <span class="nomenclature-formula-chunk"><span class="nomenclature-operator">=</span><span class="nomenclature-formula-term nomenclature-grid"><%= __('Nomenclature grid short') %><small><%= __('Nomenclature grid sign') %></small></span></span>
            <span class="nomenclature-formula-chunk"><span class="nomenclature-operator">+</span><span class="nomenclature-formula-term nomenclature-solar"><%= __('Nomenclature solar short') %><small><%= __('Nomenclature production') %></small></span></span>
            <span class="nomenclature-formula-chunk"><span class="nomenclature-operator">+</span><span class="nomenclature-formula-term nomenclature-battery"><%= __('Nomenclature discharge') %><small><%= __('Nomenclature from battery') %></small></span></span>
            <span class="nomenclature-formula-chunk"><span class="nomenclature-operator">−</span><span class="nomenclature-formula-term nomenclature-charge"><%= __('Nomenclature charge') %><small><%= __('Nomenclature into battery') %></small></span></span>
          </div>
          <p class="nomenclature-equation-explanation"><%= __('Nomenclature formula explanation') %></p>
        </div>
        <div class="nomenclature-example-grid">
          <article class="nomenclature-example-card">
            <span class="nomenclature-example-tag nomenclature-battery"><%= __('Nomenclature example discharge tag') %></span>
            <h3><%= __('Nomenclature example discharge title') %></h3>
            <p><%= __('Nomenclature example discharge description') %></p>
            <p class="nomenclature-example-equation" aria-label="<%= __('Nomenclature example discharge spoken') %>">500 + <%= number.format(1000) %> + 300 − 0 <span>= <strong><%= number.format(1800) %> W</strong></span></p>
          </article>
          <article class="nomenclature-example-card">
            <span class="nomenclature-example-tag nomenclature-solar"><%= __('Nomenclature example export tag') %></span>
            <h3><%= __('Nomenclature example export title') %></h3>
            <p><%= __('Nomenclature example export description') %></p>
            <p class="nomenclature-example-equation" aria-label="<%= __('Nomenclature example export spoken') %>">−200 + <%= number.format(1000) %> + 0 − 300 <span>= <strong>500 W</strong></span></p>
          </article>
        </div>
      </section>

      <section class="nomenclature-section" id="units" aria-labelledby="nomenclature-units-title">
        <div class="nomenclature-section-heading"><span class="nomenclature-section-number" aria-hidden="true">02</span><div><h2 id="nomenclature-units-title"><%= __('Nomenclature units title') %></h2><p><%= __('Nomenclature units subtitle') %></p></div></div>
        <div class="nomenclature-unit-grid">
          <article class="nomenclature-unit-card">
            <div class="nomenclature-unit-header"><span>W</span><svg viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-bolt-icon"/></svg></div>
            <h3><%= __('Nomenclature watts title') %></h3>
            <p><%= __('Nomenclature watts description') %></p>
          </article>
          <article class="nomenclature-unit-card">
            <div class="nomenclature-unit-header"><span>kWh</span><svg viewBox="0 0 64 64" aria-hidden="true"><use href="#nomenclature-clock-icon"/></svg></div>
            <h3><%= __('Nomenclature kwh title') %></h3>
            <p><%= __('Nomenclature kwh description') %></p>
          </article>
        </div>
        <div class="nomenclature-unit-equation">
          <p><strong><%= __('Nomenclature unit example') %></strong></p>
          <div class="nomenclature-math" aria-hidden="true">\[<%= __('Nomenclature energy equation') %>\]</div>
          <p class="nomenclature-unit-explanation"><%= __('Nomenclature energy equation spoken') %></p>
        </div>
      </section>

      <section class="nomenclature-section" id="dashboard-terms" aria-labelledby="nomenclature-dashboard-title">
        <div class="nomenclature-section-heading"><span class="nomenclature-section-number" aria-hidden="true">03</span><div><h2 id="nomenclature-dashboard-title"><%= __('Nomenclature dashboard title') %></h2><p><%= __('Nomenclature dashboard subtitle') %></p></div></div>
        <div class="nomenclature-glossary-card">
          <table class="nomenclature-glossary">
            <caption class="nomenclature-visually-hidden"><%= __('Nomenclature dashboard title') %></caption>
            <thead><tr><th scope="col"><%= __('Nomenclature column term') %></th><th scope="col"><%= __('Nomenclature column meaning') %></th></tr></thead>
            <tbody>
              <% for (const [label, explanation] of [
                ['Consumption on network', 'Nomenclature energy import'],
                ['Solar panel production energy', 'Nomenclature energy solar'],
                ['Battery discharging energy', 'Nomenclature energy discharge'],
                ['Battery charging energy', 'Nomenclature energy charge'],
                ['Total energy used', 'Nomenclature energy total'],
                ['Energy Introduced', 'Nomenclature energy export'],
                ['Energy Saved', 'Nomenclature energy saved']
              ]) { %>
                <tr><th scope="row"><%= __(label) %></th><td><%= __(explanation) %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="nomenclature-notes-grid">
          <% for (const [title, description] of [
            ['Nomenclature soc title', 'Nomenclature soc description'],
            ['Nomenclature unavailable title', 'Nomenclature unavailable description'],
            ['Nomenclature history title', 'Nomenclature history description']
          ]) { %>
            <article class="nomenclature-detail-note"><h3><%= __(title) %></h3><p><%= __(description) %></p></article>
          <% } %>
        </div>
      </section>

      <%
        // Activation logic: colours shared by the Mermaid decision diagrams.
        const mermaidClasses = [
          'classDef question fill:#ffffff,stroke:#9db5a5,color:#24392f',
          'classDef step fill:#f0f5fa,stroke:#b9cbe0,color:#24392f',
          'classDef battery fill:#f5effb,stroke:#cdb8e6,color:#4f2f78',
          'classDef on fill:#e5f3e9,stroke:#3f936b,color:#1f5c40',
          'classDef off fill:#fbeceb,stroke:#c46a64,color:#7d2e29'
        ].join('\n          ');
        const watts = value => number.format(value) + ' W';
        const percent = new Intl.NumberFormat(locale, {style: 'percent'});
      %>
      <section class="nomenclature-section" id="activation-logic" aria-labelledby="nomenclature-logic-title">
        <div class="nomenclature-section-heading"><span class="nomenclature-section-number" aria-hidden="true">04</span><div><h2 id="nomenclature-logic-title"><%= __('Nomenclature logic title') %></h2><p><%= __('Nomenclature logic subtitle') %></p></div></div>

        <div class="nomenclature-logic-overview">
          <div class="nomenclature-logic-overview-text">
            <p class="nomenclature-eyebrow"><%= __('Nomenclature logic overview eyebrow') %></p>
            <h3><%= __('Nomenclature logic overview heading') %></h3>
            <p><%= __('Nomenclature logic overview text') %></p>
            <ol class="nomenclature-logic-steps">
              <% for (const [href, title, description] of [
                ['#device-logic', 'Nomenclature logic step forced title', 'Nomenclature logic step forced'],
                ['#battery-logic', 'Nomenclature logic battery title', 'Nomenclature logic step battery'],
                ['#device-logic', 'Nomenclature logic step device a title', 'Nomenclature logic step device a'],
                ['#device-logic', 'Nomenclature logic step device b title', 'Nomenclature logic step device b'],
                ['#device-logic', 'Nomenclature logic chart more', 'Nomenclature logic step more']
              ]) { %>
                <li><span><a href="<%= href %>"><strong><%= __(title) %></strong></a> <%= __(description) %></span></li>
              <% } %>
            </ol>
          </div>
          <figure class="nomenclature-diagram-card">
            <figcaption><span class="nomenclature-eyebrow"><%= __('Nomenclature logic diagram eyebrow') %></span><strong><%= __('Nomenclature logic overview caption') %></strong></figcaption>
            <pre class="mermaid nomenclature-mermaid">
          flowchart TD
          meter(["<%= __('Nomenclature logic chart meter') %>"]) --> forced["<%= __('Nomenclature logic chart forcing') %>"]
          forced --> battery{"<%= __('Nomenclature logic chart battery question') %>"}
          battery -->|"<%= __('Nomenclature logic no') %>"| blocked["<%= __('Nomenclature logic chart all off') %>"]
          battery -->|"<%= __('Nomenclature logic yes') %>"| deviceA["<%= __('Nomenclature logic chart device a') %>"]
          deviceA -->|"<%= __('Nomenclature logic chart surplus left') %>"| deviceB["<%= __('Nomenclature logic chart device b') %>"]
          deviceB -->|"<%= __('Nomenclature logic chart surplus left') %>"| more["<%= __('Nomenclature logic chart more') %>"]
          <%- mermaidClasses %>
          class meter step
          class forced on
          class battery battery
          class deviceA,deviceB,more question
          class blocked off
            </pre>
          </figure>
        </div>

        <div class="nomenclature-subsection" id="battery-logic">
          <div class="nomenclature-subsection-heading"><span class="nomenclature-subsection-number" aria-hidden="true">4.1</span><h3><%= __('Nomenclature logic battery title') %></h3></div>
          <p class="nomenclature-subsection-intro"><%= __('Nomenclature logic battery intro') %></p>
          <div class="nomenclature-logic-split">
            <figure class="nomenclature-diagram-card">
              <figcaption><span class="nomenclature-eyebrow"><%= __('Nomenclature logic diagram eyebrow') %></span><strong><%= __('Nomenclature logic battery diagram caption') %></strong></figcaption>
              <pre class="mermaid nomenclature-mermaid">
          flowchart TD
          reading(["<%= __('Nomenclature logic chart new reading') %>"]) --> available{"<%= __('Nomenclature logic chart data available') %>"}
          available -->|"<%= __('Nomenclature logic no') %>"| blocked1["<%= __('Nomenclature logic chart devices off') %>"]
          available -->|"<%= __('Nomenclature logic yes') %>"| discharging{"<%= __('Nomenclature logic chart discharging') %>"}
          discharging -->|"<%= __('Nomenclature logic yes') %>"| blocked2["<%= __('Nomenclature logic chart devices off') %>"]
          discharging -->|"<%= __('Nomenclature logic no') %>"| charging{"<%= __('Nomenclature logic chart charging') %>"}
          charging -->|"<%= __('Nomenclature logic yes') %>"| atMax{"<%= __('Nomenclature logic chart at max') %>"}
          atMax -->|"<%= __('Nomenclature logic yes') %>"| allowed1["<%= __('Nomenclature logic chart devices allowed') %>"]
          atMax -->|"<%= __('Nomenclature logic no') %>"| blocked3["<%= __('Nomenclature logic chart devices off') %>"]
          charging -->|"<%= __('Nomenclature logic no') %>"| full{"<%= __('Nomenclature logic chart full') %>"}
          full -->|"<%= __('Nomenclature logic yes') %>"| allowed2["<%= __('Nomenclature logic chart devices allowed') %>"]
          full -->|"<%= __('Nomenclature logic no') %>"| blocked4["<%= __('Nomenclature logic chart devices off') %>"]
          <%- mermaidClasses %>
          class reading step
          class available,discharging,charging,atMax,full question
          class allowed1,allowed2 on
          class blocked1,blocked2,blocked3,blocked4 off
              </pre>
            </figure>
            <ol class="nomenclature-logic-rules">
              <% for (const [rule, why, allowed] of [
                ['Nomenclature logic rule discharging', 'Nomenclature logic rule discharging why', false],
                ['Nomenclature logic rule charging max', 'Nomenclature logic rule charging max why', true],
                ['Nomenclature logic rule charging below', 'Nomenclature logic rule charging below why', false],
                ['Nomenclature logic rule full', 'Nomenclature logic rule full why', true],
                ['Nomenclature logic rule other', 'Nomenclature logic rule other why', false],
                ['Nomenclature logic rule missing', 'Nomenclature logic rule missing why', false]
              ]) { %>
                <li>
                  <p class="nomenclature-logic-rule-head"><span><%= __(rule) %></span><span class="nomenclature-outcome <%= allowed ? 'is-on' : 'is-off' %>"><%= __(allowed ? 'Nomenclature logic outcome on' : 'Nomenclature logic outcome off') %></span></p>
                  <p><%= __(why) %></p>
                </li>
              <% } %>
            </ol>
          </div>

          <div class="nomenclature-equation-card">
            <p class="nomenclature-eyebrow"><%= __('Nomenclature logic check eyebrow') %></p>
            <h4><%= __('Nomenclature logic check title') %></h4>
            <div class="nomenclature-math-pair">
              <% for (const [label, equation, explanation] of [
                ['Nomenclature logic max label', 'Nomenclature logic max equation', 'Nomenclature logic max explanation'],
                ['Nomenclature logic full label', 'Nomenclature logic full equation', 'Nomenclature logic full explanation']
              ]) { %>
                <div class="nomenclature-math-box">
                  <p class="nomenclature-math-label"><%= __(label) %></p>
                  <div class="nomenclature-math" aria-hidden="true">\[<%= __(equation) %>\]</div>
                  <p><%= __(explanation) %></p>
                </div>
              <% } %>
            </div>
            <div class="nomenclature-logic-callout"><strong><%= __('Nomenclature logic independent title') %></strong><p><%= __('Nomenclature logic independent') %></p></div>
            <p class="nomenclature-logic-note"><%= __('Nomenclature logic settings note') %></p>
          </div>

          <p class="nomenclature-logic-examples-intro"><%= __('Nomenclature logic examples intro') %></p>
          <div class="nomenclature-example-grid">
            <% for (const example of [
              {name: 'morning', allowed: false, check: watts(350) + ' < ' + watts(750)},
              {name: 'midday', allowed: true, check: watts(800) + ' ≥ ' + watts(750)},
              {name: 'cloud', allowed: false, check: __('Nomenclature logic example cloud equation')},
              {name: 'full', allowed: true, check: percent.format(1) + ' ≥ ' + percent.format(1)}
            ]) { %>
              <article class="nomenclature-example-card">
                <span class="nomenclature-example-tag <%= example.allowed ? 'is-on' : 'is-off' %>"><%= __(example.allowed ? 'Nomenclature logic outcome on' : 'Nomenclature logic outcome off') %></span>
                <h4><%= __('Nomenclature logic example ' + example.name + ' title') %></h4>
                <p><%= __('Nomenclature logic example ' + example.name + ' description') %></p>
                <p class="nomenclature-example-equation"><%= example.check %> <span>→ <strong><%= __(example.allowed ? 'Nomenclature logic outcome on' : 'Nomenclature logic outcome off') %></strong></span></p>
              </article>
            <% } %>
          </div>
        </div>

        <div class="nomenclature-subsection" id="device-logic">
          <div class="nomenclature-subsection-heading"><span class="nomenclature-subsection-number" aria-hidden="true">4.2</span><h3><%= __('Nomenclature logic device title') %></h3></div>
          <p class="nomenclature-subsection-intro"><%= __('Nomenclature logic device intro') %></p>

          <div class="nomenclature-equation-card">
            <p class="nomenclature-eyebrow"><%= __('Nomenclature logic surplus eyebrow') %></p>
            <h4><%= __('Nomenclature logic surplus title') %></h4>
            <div class="nomenclature-math" aria-hidden="true">\[<%= __('Nomenclature logic surplus equation') %>\]</div>
            <p><%= __('Nomenclature logic surplus explanation') %></p>
            <p class="nomenclature-example-equation"><span><%= __('Nomenclature logic surplus example') %></span><span><%= number.format(1000) %> − (−600) = <strong><%= watts(1600) %></strong></span></p>
          </div>

          <div class="nomenclature-logic-split">
            <figure class="nomenclature-diagram-card">
              <figcaption><span class="nomenclature-eyebrow"><%= __('Nomenclature logic device diagram eyebrow') %></span><strong><%= __('Nomenclature logic device diagram caption') %></strong></figcaption>
              <pre class="mermaid nomenclature-mermaid">
          flowchart TD
          turn(["<%= __('Nomenclature logic chart device turn') %>"]) --> contact{"<%= __('Nomenclature logic chart contact') %>"}
          contact -->|"<%= __('Nomenclature logic no') %>"| blocked1["<%= __('Nomenclature logic chart off') %>"]
          contact -->|"<%= __('Nomenclature logic yes') %>"| limit{"<%= __('Nomenclature logic chart limit') %>"}
          limit -->|"<%= __('Nomenclature logic yes') %>"| blocked2["<%= __('Nomenclature logic chart off') %>"]
          limit -->|"<%= __('Nomenclature logic no') %>"| forced{"<%= __('Nomenclature logic chart forced') %>"}
          forced -->|"<%= __('Nomenclature logic yes') %>"| chosen["<%= __('Nomenclature logic chart forced level') %>"]
          forced -->|"<%= __('Nomenclature logic no') %>"| battery{"<%= __('Nomenclature logic chart battery yes') %>"}
          battery -->|"<%= __('Nomenclature logic no') %>"| blocked3["<%= __('Nomenclature logic chart off') %>"]
          battery -->|"<%= __('Nomenclature logic yes') %>"| kind{"<%= __('Nomenclature logic chart kind') %>"}
          kind -->|"<%= __('Nomenclature logic chart on off') %>"| enough{"<%= __('Nomenclature logic chart enough') %>"}
          enough -->|"<%= __('Nomenclature logic yes') %>"| allowed["<%= __('Nomenclature logic chart on') %>"]
          enough -->|"<%= __('Nomenclature logic no') %>"| blocked4["<%= __('Nomenclature logic chart off') %>"]
          kind -->|"<%= __('Nomenclature logic chart adjustable') %>"| level["<%= __('Nomenclature logic chart level') %>"]
          allowed --> next(["<%= __('Nomenclature logic chart next') %>"])
          level --> next
          <%- mermaidClasses %>
          class turn,next step
          class battery battery
          class contact,limit,forced,kind,enough question
          class allowed,level,chosen on
          class blocked1,blocked2,blocked3,blocked4 off
              </pre>
            </figure>
            <div class="nomenclature-logic-types">
              <% for (const name of ['on off', 'adjustable']) { %>
                <article class="nomenclature-logic-type-card">
                  <p class="nomenclature-eyebrow"><%= __('Nomenclature logic ' + name + ' eyebrow') %></p>
                  <h4><%= __('Nomenclature logic ' + name + ' title') %></h4>
                  <p><%= __('Nomenclature logic ' + name + ' description') %></p>
                  <div class="nomenclature-math" aria-hidden="true">\[<%= __('Nomenclature logic ' + name + ' equation') %>\]</div>
                  <p class="nomenclature-logic-legend"><%= __('Nomenclature logic ' + name + ' legend') %></p>
                </article>
              <% } %>
            </div>
          </div>

          <div class="nomenclature-logic-priority">
            <p class="nomenclature-eyebrow"><%= __('Nomenclature logic priority eyebrow') %></p>
            <h4><%= __('Nomenclature logic priority title') %></h4>
            <p><%= __('Nomenclature logic priority description') %></p>
          </div>
          <div class="nomenclature-example-grid">
            <article class="nomenclature-example-card">
              <span class="nomenclature-example-tag is-on"><%= __('Nomenclature logic priority a tag') %></span>
              <h4><%= __('Nomenclature logic priority a title') %></h4>
              <p><%= __('Nomenclature logic priority a description') %></p>
              <p class="nomenclature-example-equation"><%= watts(2500) %> &gt; <%= watts(2000) %> <span>→ <strong><%= __('Nomenclature logic chart on') %></strong>, <%= watts(2500) %> − <%= watts(2000) %> = <%= watts(500) %></span></p>
            </article>
            <article class="nomenclature-example-card">
              <span class="nomenclature-example-tag is-on"><%= __('Nomenclature logic priority b tag') %></span>
              <h4><%= __('Nomenclature logic priority b title') %></h4>
              <p><%= __('Nomenclature logic priority b description') %></p>
              <p class="nomenclature-example-equation">(500 − 20) ÷ <%= number.format(1000) %> <span>= <strong><%= percent.format(0.48) %> → <%= watts(480) %></strong></span></p>
            </article>
          </div>

          <h4 class="nomenclature-logic-limits-title"><%= __('Nomenclature logic limits title') %></h4>
          <div class="nomenclature-notes-grid is-two-columns">
            <% for (const name of ['target', 'energy', 'forced', 'contact']) { %>
              <article class="nomenclature-detail-note"><h5><%= __('Nomenclature logic limit ' + name + ' title') %></h5><p><%= __('Nomenclature logic limit ' + name + ' description') %></p></article>
            <% } %>
          </div>
        </div>
      </section>

      <footer class="nomenclature-footer">
        <div><p class="nomenclature-eyebrow"><%= __('Nomenclature next eyebrow') %></p><h2><%= __('Nomenclature next title') %></h2></div>
        <nav aria-label="<%= __('Nomenclature next navigation') %>">
          <a class="nomenclature-primary-link" href="/graph/power/2h/"><%= __('Nomenclature view power') %><span aria-hidden="true">↗</span></a>
          <a class="nomenclature-secondary-link" href="/energy-graph/#duration=3"><%= __('Energy summary') %><span aria-hidden="true">→</span></a>
        </nav>
      </footer>
    </main>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-mml-chtml.js"></script>
    <script id="Mermaid-script" src="https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.min.js"></script>
    <script>
      (function () {
        if (!window.mermaid) {
          // Without the diagram library, the written rules next to each diagram remain.
          document.documentElement.classList.add('nomenclature-no-mermaid');
          return;
        }
        window.mermaid.initialize({
          startOnLoad: true,
          theme: 'base',
          securityLevel: 'strict',
          fontFamily: getComputedStyle(document.body).fontFamily,
          flowchart: {curve: 'basis', useMaxWidth: true},
          themeVariables: {fontSize: '14px', lineColor: '#8a9c8f', primaryTextColor: '#24392f', edgeLabelBackground: '#ffffff'}
        });
      })();
    </script>
  </body>
</html>
