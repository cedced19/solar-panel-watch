<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name=viewport content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="/assets/main_page.css">
    <link rel="stylesheet" href="/assets/pages.css">
    <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
    <title>Solar panel watch | <%= __('Energy calendar')%></title>
  </head>
  <body class="dashboard-page subpage">
    <main class="dashboard-shell">
      <header class="dashboard-header">
        <div class="header-title">
          <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
          <nav class="header-nav" aria-label="Navigation">
            <%- include('partials/nomenclature-link') %>
            <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
            <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          </nav>
        </div>
      </header>
      <section class="card">
        <h2 class="card-heading"><%= __('Energy calendar')%></h2>
        <p class="calendar-hint"><%= __('Calendar hint')%></p>
        <div class="calendar-toolbar">
          <button id="prev-month" class="nav-btn" type="button">&#8249;</button>
          <span id="month-label" class="calendar-month"></span>
          <button id="next-month" class="nav-btn" type="button">&#8250;</button>
        </div>
        <div class="calendar-legend">
          <span class="legend-item"><span class="legend-dot has-data"></span><%= __('Energy data available')%></span>
          <span class="legend-item"><span class="legend-dot partial"></span><%= __('Partial day')%></span>
          <span class="legend-item"><span class="legend-dot no-data"></span><%= __('No energy data')%></span>
        </div>
        <div id="calendar" class="calendar"></div>
        <div id="loader" class="loader"></div>
      </section>
      <div id="day-swipe" class="day-swipe" hidden>
        <section class="card">
          <%- include('partials/energy-day-nav') %>
          <div id="day-result"></div>
        </section>
        <%- include('partials/energy-day-visuals', {intraday: false}) %>
      </div>
    </main>
    <script src="/assets/plotly.js"></script>
    <script src="/assets/energy-consumption.js"></script>
    <script src="/assets/energy-day-visuals.js"></script>
    <script src="/assets/day-swipe.js"></script>
    <%- include('partials/energy-day-table') %>
    <script>
        // Stored days: 'has-data', 'partial' or 'no-data' (computed, without readings).
        const coveredDays = new Map();
        const dayState = (row) => !row.has_data ? 'no-data' : row.complete ? 'has-data' : 'partial';
        const todayKey = '<%= today %>';
        let viewYear, viewMonth;
        let selectedDay = null;
        let dayRequest = 0; // only the latest requested day is shown

        const months = ['<%= __("January")%>', '<%= __("February")%>', '<%= __("March")%>', '<%= __("April")%>', '<%= __("May")%>', '<%= __("June")%>', '<%= __("July")%>', '<%= __("August")%>', '<%= __("September")%>', '<%= __("October")%>', '<%= __("November")%>', '<%= __("December")%>'];
        const weekdays = ['<%= __("Sun")%>', '<%= __("Mon")%>', '<%= __("Tue")%>', '<%= __("Wed")%>', '<%= __("Thu")%>', '<%= __("Fri")%>', '<%= __("Sat")%>'];

        const loadCovered = () =>
            fetch('/api/data/energy-calendar/')
                .then(response => response.json())
                .then(days => {
                    days.forEach(row => coveredDays.set(row.day, dayState(row)));
                    document.getElementById('loader').style.display = 'none';
                    renderCalendar();
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('loader').style.display = 'none';
                });

        const isoDate = (year, month, day) =>
            year + '-' + ((month + 1 < 10) ? '0' : '') + (month + 1) + '-' + ((day < 10) ? '0' : '') + day;

        const renderCalendar = () => {
            const first = new Date(viewYear, viewMonth, 1);
            const startOffset = first.getDay(); // 0 = Sunday
            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

            document.getElementById('month-label').textContent =
                months[viewMonth] + ' ' + viewYear;

            let html = '<div class="calendar-grid">';
            for (let w = 0; w < 7; w++) {
                html += '<div class="calendar-weekday">' + weekdays[w] + '</div>';
            }
            for (let i = 0; i < startOffset; i++) {
                html += '<div class="calendar-day empty"></div>';
            }
            for (let day = 1; day <= daysInMonth; day++) {
                const key = isoDate(viewYear, viewMonth, day);
                if (key > todayKey) {
                    html += '<div class="calendar-day future">' + day + '</div>';
                    continue;
                }
                html += '<div class="calendar-day ' + (coveredDays.get(key) || 'no-data') +
                    (key === selectedDay ? ' selected' : '') + '" data-date="' + key + '">' + day + '</div>';
            }
            html += '</div>';
            document.getElementById('calendar').innerHTML = html;
        };

        const updateDayNav = () => {
            document.getElementById('day-nav-label').textContent = selectedDay;
            document.getElementById('day-next').disabled = selectedDay >= todayKey;
        };

        const showDay = (row) => {
            selectedDay = row.day;
            coveredDays.set(row.day, dayState({has_data: !!row.start_date, complete: row.complete}));
            renderCalendar();
            updateDayNav();
            document.getElementById('day-swipe').hidden = false;
            // A recomputation that ends after the user moved to another day is dropped.
            renderEnergyDay(document.getElementById('day-result'), row,
                updated => { if (updated.day === selectedDay) showDay(updated); }, {heading: false});
            window.energyDayVisuals.render(row);
        };

        const showDayError = () => {
            const message = document.createElement('p');
            message.className = 'calendar-empty-result';
            message.textContent = '<%= __("Energy data unavailable")%> (' + selectedDay + ')';
            const result = document.getElementById('day-result');
            result.innerHTML = '';
            result.appendChild(message);
            document.getElementById('energy-day-visuals').hidden = true;
        };

        // Shows the stored figures of the day, computing them when missing or partial.
        // The new day slides in from the side it lies on, relative to the previous one.
        const selectDay = (day) => {
            const direction = selectedDay && day !== selectedDay ? (day < selectedDay ? 'prev' : 'next') : null;
            const request = ++dayRequest;
            const area = document.getElementById('day-swipe');
            selectedDay = day;
            viewYear = parseInt(day.slice(0, 4), 10);
            viewMonth = parseInt(day.slice(5, 7), 10) - 1;
            window.history.replaceState(null, '', '#day=' + day);
            renderCalendar();
            updateDayNav();
            area.hidden = false;
            area.classList.add('is-loading');
            fetch('/api/data/energy/day/' + day)
                .then(response => {
                    if (!response.ok) throw new Error('Energy day request failed: ' + response.status);
                    return response.json();
                })
                .then(row => {
                    if (request !== dayRequest) return;
                    area.classList.remove('is-loading');
                    showDay(row);
                    if (direction) window.daySwipe.slideIn(area, direction);
                })
                .catch(error => {
                    if (request !== dayRequest) return;
                    area.classList.remove('is-loading');
                    console.error('Error:', error);
                    showDayError();
                });
        };

        const stepDay = (direction) => {
            const day = window.daySwipe.shiftDay(selectedDay, direction === 'prev' ? -1 : 1);
            if (day <= todayKey) selectDay(day);
        };

        // #day=YYYY-MM-DD selects a day; anything else (or a day after today) is ignored.
        const dayFromHash = () => {
            const match = /^#(?:.*&)?day=(\d{4}-\d{2}-\d{2})(?:&|$)/.exec(window.location.hash || '');
            return match && window.daySwipe.isDay(match[1]) && match[1] <= todayKey ? match[1] : null;
        };
        const loadHashDay = () => {
            const day = dayFromHash();
            if (day && day !== selectedDay) selectDay(day);
        };

        document.getElementById('calendar').addEventListener('click', (event) => {
            const cell = event.target.closest('.calendar-day');
            if (cell && cell.hasAttribute('data-date')) {
                selectDay(cell.getAttribute('data-date'));
            }
        });

        document.getElementById('prev-month').addEventListener('click', () => {
            viewMonth -= 1;
            if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
            renderCalendar();
        });
        document.getElementById('next-month').addEventListener('click', () => {
            viewMonth += 1;
            if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
            renderCalendar();
        });

        document.getElementById('day-prev').addEventListener('click', () => stepDay('prev'));
        document.getElementById('day-next').addEventListener('click', () => stepDay('next'));
        window.daySwipe.attach(document.getElementById('day-swipe'), {
            canSwipe: direction => direction === 'prev' || selectedDay < todayKey,
            onSwipe: stepDay
        });

        const now = new Date();
        viewYear = now.getFullYear();
        viewMonth = now.getMonth();
        window.addEventListener('hashchange', loadHashDay);
        window.addEventListener('load', () => {
            loadCovered();
            loadHashDay();
        });
    </script>
      <script src="/assets/nav.js"></script>
</body>
</html>
