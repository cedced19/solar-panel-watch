<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name=viewport content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="/assets/main_page.css">
    <link rel="stylesheet" href="/assets/pages.css">
    <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
    <title>Solar panel watch | <%= __('Energy request history')%></title>
  </head>
  <body class="dashboard-page subpage">
    <main class="dashboard-shell">
      <header class="dashboard-header">
        <div class="header-title">
          <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
          <nav class="header-nav" aria-label="Navigation">
            <%- include('partials/nomenclature-link') %>
            <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
            <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          </nav>
        </div>
      </header>
      <div id="loader" class="loader"></div>
      <div id="table"></div>
    </main>
    <script>
        const prettyDate = (date, bold) => {
            date = new Date(date);
            return ((bold) ? '<b>': '') + ((date.getDate() < 10) ? '0': '') + date.getDate() + '/' + ((date.getMonth()+1 < 10) ? '0': '') + (date.getMonth()+1) + '/' + date.getFullYear() + ((bold) ? '</b>': '') +  ' ' + ((date.getHours() < 10) ? '0': '') + date.getHours() + ':'  + ((date.getMinutes() < 10) ? '0': '') + date.getMinutes();
        }
        const energyValue = (value) => Number.isFinite(value) ? value : '<%= __("Unavailable")%>';
        const energyWithRatio = (value, total) => {
            if (!Number.isFinite(value)) return '<%= __("Unavailable")%>';
            return value + (Number.isFinite(total) && total > 0 ?
                ' (' + Math.floor(value / total * 100) + '%)' : '');
        };
        const loadData = () => {

            const fetchData = fetch('/api/data/energy-request-hist/')
                .then(response => response.json())
            
            fetchData.then(data => {
                    data = data.reverse();
                    data.forEach(value => {

                        var h2 = document.createElement('h3');
                        h2.innerHTML = prettyDate(value.date);
                        document.getElementById('table').appendChild(h2);

                        const table = document.createElement('table');
                        const thead = document.createElement('thead');
                        const header = document.createElement('tr');
                        ['<%= __("Date Begin")%>', '<%= __("Date End")%>',
                            '<%= __("Consumption on network")%> (kWh)',
                            '<%= __("Solar panel production energy")%> (kWh)',
                            '<%= __("Battery discharging energy")%> (kWh)',
                            '<%= __("Battery charging energy")%> (kWh)',
                            '<%= __("Total energy used")%> (kWh)',
                            '<%= __("Energy Introduced")%> (kWh)',
                            '<%= __("Energy Saved")%> (kWh)'].forEach(label => {
                            const th = document.createElement('th');
                            th.textContent = label;
                            header.appendChild(th);
                        });
                        thead.appendChild(header);
                        table.appendChild(thead);

                        const tbody = document.createElement('tbody');
                        for (const r of value.result.slice().reverse()) {
                            const tr = document.createElement('tr');
                            const energySaved = Number.isFinite(r.house_consumption) && Number.isFinite(r.consumption_on_network) ?
                                Math.floor((r.house_consumption - r.consumption_on_network) * 1000) / 1000 : null;
                            const cells = [prettyDate(r.start_date), prettyDate(r.end_date),
                                energyWithRatio(r.consumption_on_network, r.house_consumption),
                                energyValue(r.solar_panel), energyValue(r.battery_discharging),
                                energyValue(r.battery_charging), energyValue(r.house_consumption),
                                energyValue(r.introduced_on_network), energyWithRatio(energySaved, r.house_consumption)];
                            cells.forEach((text, index) => {
                                const td = document.createElement('td');
                                if (index === 0) td.innerHTML = prettyDate(r.start_date, true);
                                else td.appendChild(document.createTextNode(text));
                                tr.appendChild(td);
                            });
                            tbody.appendChild(tr);
                        }
                        table.appendChild(tbody);
                        document.getElementById('table').appendChild(table);

                        document.getElementById('loader').style.display = 'none';
                    });
            })
            .catch(error => {
                    console.error('Error:', error);
            });
        }
        window.addEventListener('load', loadData);
    </script>
      <script src="/assets/nav.js"></script>
</body>
</html>
