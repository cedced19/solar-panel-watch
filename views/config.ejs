<%
  // Texts used by /assets/config-panel.js, keyed by the name the script uses.
  const messageKeys = {
    codeSent: 'Config code sent',
    show: 'Config show',
    hide: 'Config hide',
    add: 'Config add',
    remove: 'Config remove',
    loading: 'Config loading',
    sendingCode: 'Config sending code',
    checking: 'Config checking',
    saving: 'Config saving',
    saved: 'Config saved',
    unsaved: 'Config unsaved',
    restarting: 'Config restarting',
    restarted: 'Config restarted',
    restartTimeout: 'Config restart timeout',
    invalidJson: 'Config invalid json',
    invalidNumber: 'Config invalid number',
    sessionExpired: 'Config session expired',
    requestFailed: 'Config request failed',
    'invalid-code': 'Config error invalid-code',
    'code-expired': 'Config error code-expired',
    'too-many-attempts': 'Config error too-many-attempts',
    'mails-required': 'Config error mails-required',
    'invalid-mail': 'Config error invalid-mail',
    'config-object': 'Config error config-object',
    'sender-required': 'Config error sender-required',
    'sender-failed': 'Config error sender-failed',
    'write-failed': 'Config error write-failed',
    'read-failed': 'Config error read-failed'
  };
  const messages = {};
  Object.keys(messageKeys).forEach(function (name) { messages[name] = __(messageKeys[name]); });
%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name=viewport content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="stylesheet" href="/assets/main_page.css">
  <link rel="stylesheet" href="/assets/pages.css">
  <link href=/favicon.ico rel="shortcut icon" type=image/x-icon>
  <link rel=manifest href=/assets/manifest.json>
  <title><%= __('Configuration')%> | Solar Panel Watch</title>
</head>
<body class="dashboard-page subpage config-page">
  <main class="dashboard-shell" id="config-panel" data-otp-ttl="<%= otp_ttl_minutes %>" data-messages="<%= JSON.stringify(messages) %>">
    <header class="dashboard-header">
      <div class="header-title">
        <h1><a href="/" style="color:inherit;text-decoration:none;">Solar Panel Watch</a></h1>
        <nav class="header-nav" aria-label="Navigation">
          <a class="nav-btn" href="/" title="<%= __('Home')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="nav-label"><%= __('Home')%></span>
          </a>
          <button class="nav-btn" id="nav-back" type="button" hidden title="<%= __('Back')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
            <span class="nav-label"><%= __('Back')%></span>
          </button>
          <button class="nav-btn" id="logout-btn" type="button" hidden title="<%= __('Config log out')%>">
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span class="nav-label"><%= __('Config log out')%></span>
          </button>
        </nav>
      </div>
    </header>

    <div class="loader" id="config-loader"></div>

    <section class="card login-card" id="login-view" hidden>
      <h2 class="card-heading"><%= __('Config sign in')%></h2>
      <form id="email-form" class="login-form">
        <p class="config-note"><%= __('Config email note')%></p>
        <label for="login-email"><%= __('Config email')%></label>
        <input type="email" id="login-email" name="email" autocomplete="email" required>
        <fieldset class="sender-setup" id="sender-setup"<% if (sender_configured) { %> hidden disabled<% } %>>
          <legend><%= __('Config sender setup title')%></legend>
          <p class="config-note"><%= __('Config sender setup note')%></p>
          <label for="sender-user"><%= __('Config sender user')%></label>
          <input type="email" id="sender-user" name="sender_user" autocomplete="off" required>
          <label for="sender-pass"><%= __('Config sender pass')%></label>
          <input type="password" id="sender-pass" name="sender_pass" autocomplete="new-password" required>
        </fieldset>
        <button type="submit"><%= __('Config send code')%></button>
      </form>
      <form id="code-form" class="login-form" hidden>
        <p class="config-note" id="code-note"></p>
        <label for="login-code"><%= __('Config code')%></label>
        <input type="text" id="login-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required>
        <div class="config-buttons">
          <button type="submit"><%= __('Config verify')%></button>
          <button type="button" class="config-btn" id="change-email"><%= __('Config change email')%></button>
        </div>
      </form>
      <p class="config-status" id="login-status" role="status"></p>
    </section>

    <section class="card config-card" id="editor-view" hidden>
      <div class="config-toolbar">
        <h2 class="card-heading"><%= __('Configuration')%> <span class="config-file">config.json</span></h2>
        <div class="config-tabs" role="tablist">
          <button type="button" role="tab" id="tab-form" aria-selected="true" aria-controls="config-form"><%= __('Config form')%></button>
          <button type="button" role="tab" id="tab-json" aria-selected="false" aria-controls="config-json">JSON</button>
        </div>
      </div>
      <p class="config-note"><%= __('Config signed in as')%> <strong id="signed-in-email"></strong>. <%= __('Config note')%></p>
      <div class="restart-banner" id="restart-banner" hidden>
        <span><%= __('Config restart required')%></span>
        <button type="button" id="restart-btn"><%= __('Config restart')%></button>
      </div>
      <form id="config-form" class="config-form" novalidate></form>
      <textarea id="config-json" class="config-json" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="config.json" hidden></textarea>
      <div class="config-actions">
        <button type="button" id="save-btn" disabled><%= __('Config save')%></button>
        <button type="button" class="config-btn" id="discard-btn" disabled><%= __('Config discard')%></button>
        <span class="config-status" id="editor-status" role="status"></span>
      </div>
    </section>
  </main>
  <script src="/assets/nav.js"></script>
  <script src="/assets/config-panel.js"></script>
</body>
</html>
